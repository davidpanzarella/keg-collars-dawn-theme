    "custom_liquid_TrGzmm": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n  .kc-reorder {\n    max-width: 980px;\n    margin: 0 auto;\n    padding: 24px 20px 50px;\n    color: #202328;\n  }\n\n  .kc-reorder__intro {\n    text-align: center;\n    max-width: 720px;\n    margin: 0 auto 34px;\n  }\n\n  .kc-reorder__intro h2 {\n    margin: 0 0 10px;\n    font-size: 32px;\n    line-height: 1.15;\n    font-weight: 700;\n    letter-spacing: -0.02em;\n  }\n\n  .kc-reorder__intro p {\n    margin: 0;\n    font-size: 16px;\n    line-height: 1.6;\n    color: #666;\n  }\n\n  .kc-form-section {\n    border-top: 1px solid #dedede;\n    padding: 30px 0;\n  }\n\n  .kc-form-section:first-of-type {\n    border-top: 0;\n    padding-top: 0;\n  }\n\n  .kc-section-heading {\n    display: flex;\n    align-items: center;\n    gap: 14px;\n    margin-bottom: 22px;\n  }\n\n  .kc-section-number {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    width: 34px;\n    height: 34px;\n    flex: 0 0 34px;\n    border-radius: 50%;\n    background: #f5a000;\n    color: #202328;\n    font-size: 14px;\n    font-weight: 700;\n  }\n\n  .kc-section-heading h3 {\n    margin: 0;\n    font-size: 21px;\n    line-height: 1.2;\n    font-weight: 700;\n  }\n\n  .kc-grid {\n    display: grid;\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    gap: 20px;\n  }\n\n  .kc-field {\n    margin-bottom: 20px;\n  }\n\n  .kc-field:last-child {\n    margin-bottom: 0;\n  }\n\n  .kc-field label,\n  .kc-field-label {\n    display: block;\n    margin-bottom: 7px;\n    font-size: 14px;\n    line-height: 1.4;\n    font-weight: 700;\n    color: #202328;\n  }\n\n  .kc-required {\n    color: #c85032;\n  }\n\n  .kc-field input[type=\"text\"],\n  .kc-field input[type=\"email\"],\n  .kc-field input[type=\"tel\"],\n  .kc-field input[type=\"date\"],\n  .kc-field select,\n  .kc-field textarea,\n  .kc-order-row input,\n  .kc-order-row select {\n    width: 100%;\n    min-height: 48px;\n    box-sizing: border-box;\n    border: 1px solid #cfcfcf;\n    border-radius: 4px;\n    background: #fff;\n    color: #202328;\n    font: inherit;\n    padding: 11px 13px;\n    box-shadow: none;\n  }\n\n  .kc-field textarea {\n    min-height: 115px;\n    resize: vertical;\n  }\n\n  .kc-field input:focus,\n  .kc-field select:focus,\n  .kc-field textarea:focus,\n  .kc-order-row input:focus,\n  .kc-order-row select:focus {\n    outline: none;\n    border-color: #f5a000;\n    box-shadow: 0 0 0 2px rgba(245,160,0,.16);\n  }\n\n  .kc-help {\n    margin: 7px 0 0;\n    font-size: 13px;\n    line-height: 1.5;\n    color: #777;\n  }\n\n  .kc-order-header,\n  .kc-order-row {\n    display: grid;\n    grid-template-columns: 2fr .7fr;\n    gap: 12px;\n  }\n\n  .kc-order-header {\n    margin-bottom: 7px;\n    font-size: 12px;\n    font-weight: 700;\n    text-transform: uppercase;\n    letter-spacing: .05em;\n    color: #666;\n  }\n\n  .kc-order-row {\n    margin-bottom: 10px;\n  }\n\n  .kc-option-card {\n    display: flex;\n    align-items: flex-start;\n    gap: 12px;\n    border: 1px solid #d8d8d8;\n    border-radius: 4px;\n    padding: 14px 16px;\n    cursor: pointer;\n    background: #fff;\n  }\n\n  .kc-option-card + .kc-option-card {\n    margin-top: 10px;\n  }\n\n  .kc-option-card:hover {\n    border-color: #f5a000;\n  }\n\n  .kc-option-card strong {\n    display: block;\n    margin-bottom: 2px;\n  }\n\n  .kc-option-card input[type=\"checkbox\"],\n  .kc-option-card input[type=\"radio\"] {\n    appearance: none !important;\n    -webkit-appearance: none !important;\n    width: 18px !important;\n    height: 18px !important;\n    min-width: 18px !important;\n    min-height: 18px !important;\n    margin: 2px 0 0;\n    background: #fff;\n    border: 2px solid #9a9a9a;\n    cursor: pointer;\n    display: inline-grid;\n    place-content: center;\n    flex: 0 0 auto;\n  }\n\n  .kc-option-card input[type=\"checkbox\"] {\n    border-radius: 3px;\n  }\n\n  .kc-option-card input[type=\"radio\"] {\n    border-radius: 50%;\n  }\n\n  .kc-option-card input[type=\"checkbox\"]::before {\n    content: \"\";\n    width: 9px;\n    height: 5px;\n    border-left: 2px solid #202328;\n    border-bottom: 2px solid #202328;\n    transform: rotate(-45deg) scale(0);\n    transform-origin: center;\n    transition: transform .08s ease-in-out;\n    margin-top: -2px;\n  }\n\n  .kc-option-card input[type=\"checkbox\"]:checked {\n    background: #f5a000;\n    border-color: #f5a000;\n  }\n\n  .kc-option-card input[type=\"checkbox\"]:checked::before {\n    transform: rotate(-45deg) scale(1);\n  }\n\n  .kc-option-card input[type=\"radio\"]::before {\n    content: \"\";\n    width: 8px;\n    height: 8px;\n    border-radius: 50%;\n    background: #202328;\n    transform: scale(0);\n    transition: transform .08s ease-in-out;\n  }\n\n  .kc-option-card input[type=\"radio\"]:checked {\n    border-color: #f5a000;\n    background: #f5a000;\n  }\n\n  .kc-option-card input[type=\"radio\"]:checked::before {\n    transform: scale(1);\n  }\n\n  .kc-add-row {\n    border: 0;\n    background: transparent;\n    color: #202328;\n    padding: 5px 0;\n    font: inherit;\n    font-size: 14px;\n    font-weight: 700;\n    cursor: pointer;\n    text-decoration: underline;\n    text-underline-offset: 3px;\n  }\n\n  .kc-hidden {\n    display: none;\n  }\n\n  .kc-date-wrap {\n    max-width: 420px;\n  }\n\n  .kc-reassurance {\n    margin: 5px 0 24px;\n    padding: 16px 18px;\n    border-left: 4px solid #f5a000;\n    background: #f7f7f7;\n    font-size: 14px;\n    line-height: 1.5;\n  }\n\n  .kc-reassurance strong {\n    color: #202328;\n  }\n\n  .kc-submit-area {\n    text-align: center;\n  }\n\n  .kc-submit {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    min-height: 52px;\n    min-width: 260px;\n    border: 0;\n    border-radius: 3px;\n    padding: 13px 28px;\n    background: #f5a000;\n    color: #202328;\n    font: inherit;\n    font-size: 15px;\n    font-weight: 700;\n    cursor: pointer;\n  }\n\n  .kc-submit:hover {\n    opacity: .9;\n  }\n\n  .kc-submit-note {\n    max-width: 650px;\n    margin: 14px auto 0;\n    font-size: 13px;\n    line-height: 1.5;\n    color: #777;\n  }\n\n  .kc-success {\n    margin: 20px 0 30px;\n    border: 1px solid #c9dfc7;\n    border-radius: 4px;\n    padding: 22px;\n    background: #f4faf3;\n    text-align: center;\n  }\n\n  .kc-success h3 {\n    margin: 0 0 7px;\n    font-size: 22px;\n  }\n\n  .kc-success p {\n    margin: 0;\n    line-height: 1.6;\n  }\n\n  .kc-errors {\n    margin-bottom: 24px;\n    border: 1px solid #e0b5ae;\n    border-radius: 4px;\n    padding: 16px 20px;\n    background: #fff5f3;\n  }\n\n  @media screen and (max-width: 749px) {\n    .kc-reorder {\n      padding: 20px 16px 40px;\n    }\n\n    .kc-reorder__intro h2 {\n      font-size: 27px;\n    }\n\n    .kc-grid {\n      grid-template-columns: 1fr;\n    }\n\n    .kc-order-header {\n      display: none;\n    }\n\n    .kc-order-row {\n      grid-template-columns: 1fr;\n      gap: 8px;\n      padding-bottom: 14px;\n      border-bottom: 1px solid #eee;\n    }\n  }\n</style>\n\n<div class=\"kc-reorder\">\n\n  <div class=\"kc-reorder__intro\">\n    <h2>Tell Us What You Need</h2>\n    <p>\n      Complete the information below and we'll locate your previous order,\n      verify your artwork and confirm everything before production.\n    </p>\n  </div>\n\n  {% form 'contact', id: 'KegCollarsReorderForm' %}\n\n    {% if form.posted_successfully? %}\n      <div class=\"kc-success\">\n        <h3>Reorder Request Received!</h3>\n        <p>\n          We'll review your previous order and artwork and contact you to confirm\n          pricing, production details and next steps.\n        </p>\n      </div>\n    {% endif %}\n\n    {% if form.errors %}\n      <div class=\"kc-errors\">\n        {{ form.errors | default_errors }}\n      </div>\n    {% endif %}\n\n    <input type=\"hidden\" name=\"contact[Request Type]\" value=\"REORDER REQUEST\">\n\n    <!-- 01 YOUR INFORMATION -->\n    <div class=\"kc-form-section\">\n      <div class=\"kc-section-heading\">\n        <span class=\"kc-section-number\">01</span>\n        <h3>Your Information</h3>\n      </div>\n\n      <div class=\"kc-grid\">\n\n        <div class=\"kc-field\">\n          <label for=\"kc-name\">\n            Full Name <span class=\"kc-required\">*</span>\n          </label>\n          <input\n            id=\"kc-name\"\n            type=\"text\"\n            name=\"contact[Full Name]\"\n            autocomplete=\"name\"\n            required\n          >\n        </div>\n\n        <div class=\"kc-field\">\n          <label for=\"kc-business\">\n            Business Name <span class=\"kc-required\">*</span>\n          </label>\n          <input\n            id=\"kc-business\"\n            type=\"text\"\n            name=\"contact[Business Name]\"\n            autocomplete=\"organization\"\n            required\n          >\n        </div>\n\n        <div class=\"kc-field\">\n          <label for=\"kc-email\">\n            Email Address <span class=\"kc-required\">*</span>\n          </label>\n          <input\n            id=\"kc-email\"\n            type=\"email\"\n            name=\"contact[email]\"\n            autocomplete=\"email\"\n            required\n          >\n        </div>\n\n        <div class=\"kc-field\">\n          <label for=\"kc-phone\">\n            Phone Number\n          </label>\n          <input\n            id=\"kc-phone\"\n            type=\"tel\"\n            name=\"contact[Phone]\"\n            autocomplete=\"tel\"\n          >\n        </div>\n\n      </div>\n    </div>\n\n    <!-- 02 WHAT ARE YOU REORDERING -->\n    <div class=\"kc-form-section\">\n\n      <div class=\"kc-section-heading\">\n        <span class=\"kc-section-number\">02</span>\n        <h3>What Are You Reordering?</h3>\n      </div>\n\n      <div class=\"kc-field\">\n        <label for=\"kc-order\">\n          Previous Order Number <span class=\"kc-required\">*</span>\n        </label>\n\n        <input\n          id=\"kc-order\"\n          type=\"text\"\n          name=\"contact[Previous Order Number]\"\n          placeholder=\"Example: #12345 or enter UNKNOWN\"\n          required\n        >\n\n        <p class=\"kc-help\">\n          Can't find it? Enter <strong>UNKNOWN</strong> and we'll look it up using your business name and email address.\n        </p>\n      </div>\n\n      <div class=\"kc-grid\">\n\n        <div class=\"kc-field\">\n          <label for=\"kc-primary-product\">\n            Product <span class=\"kc-required\">*</span>\n          </label>\n\n          <select\n            id=\"kc-primary-product\"\n            name=\"contact[Primary Product]\"\n            required\n          >\n            <option value=\"\">Select a product</option>\n            <option value=\"Keg Collars\">Keg Collars</option>\n            <option value=\"Growler Tags\">Growler Tags</option>\n            <option value=\"Coasters\">Coasters</option>\n            <option value=\"Flight Cards\">Flight Cards</option>\n            <option value=\"Menus\">Menus</option>\n            <option value=\"Keg Caps\">Keg Caps</option>\n            <option value=\"Keg Wraps\">Keg Wraps</option>\n            <option value=\"Labels\">Labels</option>\n            <option value=\"Punch / Reward Cards\">Punch / Reward Cards</option>\n            <option value=\"Other\">Other</option>\n          </select>\n        </div>\n\n        <div class=\"kc-field\">\n          <label for=\"kc-primary-quantity\">\n            Quantity <span class=\"kc-required\">*</span>\n          </label>\n\n          <input\n            id=\"kc-primary-quantity\"\n            type=\"text\"\n            name=\"contact[Primary Quantity]\"\n            placeholder=\"Example: 2,000\"\n            required\n          >\n        </div>\n\n      </div>\n\n      <div class=\"kc-field\">\n        <label class=\"kc-option-card\">\n\n          <input\n            type=\"checkbox\"\n            id=\"kcMultipleProducts\"\n            name=\"contact[Multiple Product Types]\"\n            value=\"Yes\"\n          >\n\n          <span>\n            <strong>This reorder includes multiple product types</strong>\n            For example: Keg Collars + Growler Tags + Coasters.\n          </span>\n\n        </label>\n      </div>\n\n      <div\n        id=\"kcMultipleProductsBox\"\n        class=\"kc-hidden\"\n        style=\"margin-bottom:20px;\"\n      >\n\n        <p class=\"kc-field-label\">\n          Additional Products\n        </p>\n\n        <div id=\"kcAdditionalProducts\">\n\n          <div class=\"kc-order-header\">\n            <div>Product</div>\n            <div>Quantity</div>\n          </div>\n\n          <div class=\"kc-order-row\">\n\n            <select name=\"contact[Additional Product 1]\">\n              <option value=\"\">Select another product</option>\n              <option value=\"Keg Collars\">Keg Collars</option>\n              <option value=\"Growler Tags\">Growler Tags</option>\n              <option value=\"Coasters\">Coasters</option>\n              <option value=\"Flight Cards\">Flight Cards</option>\n              <option value=\"Menus\">Menus</option>\n              <option value=\"Keg Caps\">Keg Caps</option>\n              <option value=\"Keg Wraps\">Keg Wraps</option>\n              <option value=\"Labels\">Labels</option>\n              <option value=\"Punch / Reward Cards\">Punch / Reward Cards</option>\n              <option value=\"Other\">Other</option>\n            </select>\n\n            <input\n              type=\"text\"\n              name=\"contact[Additional Product Quantity 1]\"\n              placeholder=\"Quantity\"\n            >\n\n          </div>\n\n        </div>\n\n        <button\n          type=\"button\"\n          class=\"kc-add-row\"\n          id=\"kcAddProduct\"\n        >\n          + Add Another Product\n        </button>\n\n      </div>\n\n      <div class=\"kc-field\">\n        <label class=\"kc-option-card\">\n\n          <input\n            type=\"checkbox\"\n            id=\"kcMultipleVersions\"\n            name=\"contact[Multiple Versions]\"\n            value=\"Yes\"\n          >\n\n          <span>\n            <strong>This product has multiple versions or designs</strong>\n            For example: Hazy IPA, Pilsner and West Coast IPA.\n          </span>\n\n        </label>\n      </div>\n\n    </div>\n\n    <!-- OPTIONAL 03 -->\n    <div\n      class=\"kc-form-section kc-hidden\"\n      id=\"kcVersionsSection\"\n    >\n\n      <div class=\"kc-section-heading\">\n        <span class=\"kc-section-number\">03</span>\n        <h3>Versions &amp; Quantities</h3>\n      </div>\n\n      <p class=\"kc-help\" style=\"margin-bottom:18px;\">\n        Tell us how the quantity should be divided between your different versions or designs.\n      </p>\n\n      <div id=\"kcOrderRows\">\n\n        <div class=\"kc-order-header\">\n          <div>Version / Design</div>\n          <div>Quantity</div>\n        </div>\n\n        <div class=\"kc-order-row\">\n\n          <input\n            type=\"text\"\n            name=\"contact[Version 1]\"\n            placeholder=\"Example: Hazy IPA\"\n          >\n\n          <input\n            type=\"text\"\n            name=\"contact[Version Quantity 1]\"\n            placeholder=\"500\"\n          >\n\n        </div>\n\n        <div class=\"kc-order-row\">\n\n          <input\n            type=\"text\"\n            name=\"contact[Version 2]\"\n            placeholder=\"Example: Pilsner\"\n          >\n\n          <input\n            type=\"text\"\n            name=\"contact[Version Quantity 2]\"\n            placeholder=\"1,000\"\n          >\n\n        </div>\n\n      </div>\n\n      <button\n        type=\"button\"\n        class=\"kc-add-row\"\n        id=\"kcAddVersion\"\n      >\n        + Add Another Version\n      </button>\n\n    </div>\n\n    <!-- ARTWORK -->\n    <div class=\"kc-form-section\">\n\n      <div class=\"kc-section-heading\">\n        <h3>Artwork &amp; Changes</h3>\n      </div>\n\n      <div class=\"kc-field\">\n\n        <span class=\"kc-field-label\">\n          Are there any changes from your previous order?\n          <span class=\"kc-required\">*</span>\n        </span>\n\n        <div>\n\n          <label class=\"kc-option-card\">\n\n            <input\n              type=\"radio\"\n              name=\"contact[Artwork Changes]\"\n              value=\"NO - Print exactly as previously ordered\"\n              required\n            >\n\n            <span>\n              <strong>No changes</strong>\n              Print exactly as previously ordered.\n            </span>\n\n          </label>\n\n          <label class=\"kc-option-card\">\n\n            <input\n              type=\"radio\"\n              name=\"contact[Artwork Changes]\"\n              value=\"YES - Changes are needed\"\n              required\n            >\n\n            <span>\n              <strong>Yes, changes are needed</strong>\n              I need to update information or artwork before printing.\n            </span>\n\n          </label>\n\n        </div>\n\n      </div>\n\n      <div\n        class=\"kc-field kc-hidden\"\n        id=\"kcChangeBox\"\n      >\n\n        <label for=\"kc-changes\">\n          Describe Your Changes\n        </label>\n\n        <textarea\n          id=\"kc-changes\"\n          name=\"contact[Requested Changes]\"\n          placeholder=\"Example: Change the ABV from 6.2% to 6.5%. Everything else stays the same.\"\n        ></textarea>\n\n      </div>\n\n    </div>\n\n    <!-- FINAL DETAILS -->\n    <div class=\"kc-form-section\">\n\n      <div class=\"kc-section-heading\">\n        <h3>Final Details</h3>\n      </div>\n\n      <div class=\"kc-field kc-date-wrap\">\n\n        <label for=\"kc-date\">\n          Requested In-Hand Date\n        </label>\n\n        <input\n          id=\"kc-date\"\n          type=\"date\"\n          name=\"contact[Requested In-Hand Date]\"\n        >\n\n        <p class=\"kc-help\">\n          We'll confirm production timing and delivery with your reorder.\n        </p>\n\n      </div>\n\n      <div class=\"kc-field\">\n\n        <label for=\"kc-notes\">\n          Additional Notes\n        </label>\n\n        <textarea\n          id=\"kc-notes\"\n          name=\"contact[Additional Notes]\"\n          placeholder=\"Deadlines, shipping instructions, special requests or anything else we should know.\"\n        ></textarea>\n\n      </div>\n\n    </div>\n\n    <div class=\"kc-reassurance\">\n      <strong>Nothing goes to production until we confirm your reorder.</strong>\n      We'll review your previous artwork, quantities, pricing and any requested changes before printing.\n    </div>\n\n    <div class=\"kc-submit-area\">\n\n      <button\n        type=\"submit\"\n        class=\"kc-submit\"\n      >\n        SUBMIT REORDER REQUEST →\n      </button>\n\n      <p class=\"kc-submit-note\">\n        Your reorder is not considered confirmed until a member of our team contacts you.\n      </p>\n\n    </div>\n\n  {% endform %}\n\n</div>\n\n<script>\ndocument.addEventListener('DOMContentLoaded', function() {\n\n  var multipleProducts = document.getElementById('kcMultipleProducts');\n  var multipleProductsBox = document.getElementById('kcMultipleProductsBox');\n\n  if (multipleProducts && multipleProductsBox) {\n    multipleProducts.addEventListener('change', function() {\n      if (this.checked) {\n        multipleProductsBox.classList.remove('kc-hidden');\n      } else {\n        multipleProductsBox.classList.add('kc-hidden');\n      }\n    });\n  }\n\n\n  var addProductButton = document.getElementById('kcAddProduct');\n  var additionalProducts = document.getElementById('kcAdditionalProducts');\n  var productCount = 1;\n\n  if (addProductButton && additionalProducts) {\n    addProductButton.addEventListener('click', function() {\n\n      productCount++;\n\n      var row = document.createElement('div');\n      row.className = 'kc-order-row';\n\n      row.innerHTML = `\n        <select name=\"contact[Additional Product ${productCount}]\">\n          <option value=\"\">Select another product</option>\n          <option value=\"Keg Collars\">Keg Collars</option>\n          <option value=\"Growler Tags\">Growler Tags</option>\n          <option value=\"Coasters\">Coasters</option>\n          <option value=\"Flight Cards\">Flight Cards</option>\n          <option value=\"Menus\">Menus</option>\n          <option value=\"Keg Caps\">Keg Caps</option>\n          <option value=\"Keg Wraps\">Keg Wraps</option>\n          <option value=\"Labels\">Labels</option>\n          <option value=\"Punch / Reward Cards\">Punch / Reward Cards</option>\n          <option value=\"Other\">Other</option>\n        </select>\n\n        <input\n          type=\"text\"\n          name=\"contact[Additional Product Quantity ${productCount}]\"\n          placeholder=\"Quantity\"\n        >\n      `;\n\n      additionalProducts.appendChild(row);\n    });\n  }\n\n\n  var multipleVersions = document.getElementById('kcMultipleVersions');\n  var versionsSection = document.getElementById('kcVersionsSection');\n\n  if (multipleVersions && versionsSection) {\n    multipleVersions.addEventListener('change', function() {\n\n      if (this.checked) {\n        versionsSection.classList.remove('kc-hidden');\n      } else {\n        versionsSection.classList.add('kc-hidden');\n      }\n\n    });\n  }\n\n\n  var addVersionButton = document.getElementById('kcAddVersion');\n  var orderRows = document.getElementById('kcOrderRows');\n  var versionCount = 2;\n\n  if (addVersionButton && orderRows) {\n    addVersionButton.addEventListener('click', function() {\n\n      versionCount++;\n\n      var row = document.createElement('div');\n      row.className = 'kc-order-row';\n\n      row.innerHTML = `\n        <input\n          type=\"text\"\n          name=\"contact[Version ${versionCount}]\"\n          placeholder=\"Additional version\"\n        >\n\n        <input\n          type=\"text\"\n          name=\"contact[Version Quantity ${versionCount}]\"\n          placeholder=\"Quantity\"\n        >\n      `;\n\n      orderRows.appendChild(row);\n    });\n  }\n\n\n  var artworkRadios =\n    document.querySelectorAll('input[name=\"contact[Artwork Changes]\"]');\n\n  var changeBox =\n    document.getElementById('kcChangeBox');\n\n  artworkRadios.forEach(function(radio) {\n\n    radio.addEventListener('change', function() {\n\n      if (this.value.indexOf('YES') === 0) {\n\n        changeBox.classList.remove('kc-hidden');\n\n      } else {\n\n        changeBox.classList.add('kc-hidden');\n\n        var changes =\n          document.getElementById('kc-changes');\n\n        if (changes) {\n          changes.value = '';\n        }\n\n      }\n\n    });\n\n  });\n\n});\n</script>",
