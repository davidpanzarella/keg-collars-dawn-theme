    "custom_liquid_TrGzmm": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n  .kc-reorder {\n    max-width: 980px;\n    margin: 0 auto;\n    padding: 24px 20px 50px;\n    color: #202328;\n  }\n\n  .kc-reorder__intro {\n    text-align: center;\n    max-width: 720px;\n    margin: 0 auto 34px;\n  }\n\n  .kc-reorder__intro h2 {\n    margin: 0 0 10px;\n    font-size: 32px;\n    line-height: 1.15;\n    font-weight: 700;\n  }\n\n  .kc-reorder__intro p {\n    margin: 0;\n    font-size: 16px;\n    line-height: 1.6;\n    color: #666;\n  }\n\n  .kc-form-section {\n    border-top: 1px solid #dedede;\n    padding: 30px 0;\n  }\n\n  .kc-form-section:first-of-type {\n    border-top: 0;\n    padding-top: 0;\n  }\n\n  .kc-section-heading {\n    display: flex;\n    align-items: center;\n    gap: 14px;\n    margin-bottom: 22px;\n  }\n\n  .kc-section-number {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    width: 34px;\n    height: 34px;\n    flex: 0 0 34px;\n    border-radius: 50%;\n    background: #f5a000;\n    color: #202328;\n    font-size: 14px;\n    font-weight: 700;\n  }\n\n  .kc-section-heading h3 {\n    margin: 0;\n    font-size: 21px;\n    line-height: 1.2;\n    font-weight: 700;\n  }\n\n  .kc-grid {\n    display: grid;\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    gap: 20px;\n  }\n\n  .kc-field {\n    margin-bottom: 20px;\n  }\n\n  .kc-field:last-child {\n    margin-bottom: 0;\n  }\n\n  .kc-field label,\n  .kc-field-label {\n    display: block;\n    margin-bottom: 7px;\n    font-size: 14px;\n    line-height: 1.4;\n    font-weight: 700;\n    color: #202328;\n  }\n\n  .kc-required {\n    color: #c85032;\n  }\n\n  .kc-field input[type=\"text\"],\n  .kc-field input[type=\"email\"],\n  .kc-field input[type=\"tel\"],\n  .kc-field input[type=\"date\"],\n  .kc-field select,\n  .kc-field textarea,\n  .kc-product-row input,\n  .kc-product-row select,\n  .kc-version-row input {\n    width: 100%;\n    min-height: 48px;\n    box-sizing: border-box;\n    border: 1px solid #cfcfcf;\n    border-radius: 4px;\n    background: #fff;\n    color: #202328;\n    font: inherit;\n    padding: 11px 13px;\n    box-shadow: none;\n  }\n\n  .kc-field textarea {\n    min-height: 115px;\n    resize: vertical;\n  }\n\n  .kc-field input:focus,\n  .kc-field select:focus,\n  .kc-field textarea:focus,\n  .kc-product-row input:focus,\n  .kc-product-row select:focus,\n  .kc-version-row input:focus {\n    outline: none;\n    border-color: #f5a000;\n    box-shadow: 0 0 0 2px rgba(245,160,0,.16);\n  }\n\n  .kc-help {\n    margin: 7px 0 0;\n    font-size: 13px;\n    line-height: 1.5;\n    color: #777;\n  }\n\n  .kc-product-block {\n    padding: 0 0 24px;\n  }\n\n  .kc-product-block + .kc-product-block {\n    border-top: 1px dashed #d5d5d5;\n    padding-top: 24px;\n  }\n\n  .kc-product-block-title {\n    margin: 0 0 14px;\n    font-size: 16px;\n    font-weight: 700;\n  }\n\n  .kc-product-row {\n    display: grid;\n    grid-template-columns: 2fr .8fr;\n    gap: 12px;\n  }\n\n  .kc-option-card {\n    display: flex !important;\n    align-items: flex-start;\n    gap: 12px;\n    margin-top: 14px;\n    border: 1px solid #d8d8d8;\n    border-radius: 4px;\n    padding: 14px 16px;\n    cursor: pointer;\n    background: #fff;\n  }\n\n  .kc-option-card:hover {\n    border-color: #f5a000;\n  }\n\n  .kc-option-card strong {\n    display: block;\n    margin-bottom: 2px;\n  }\n\n  .kc-option-card input[type=\"checkbox\"],\n  .kc-option-card input[type=\"radio\"] {\n    appearance: none !important;\n    -webkit-appearance: none !important;\n    width: 18px !important;\n    height: 18px !important;\n    min-width: 18px !important;\n    min-height: 18px !important;\n    margin: 2px 0 0 !important;\n    padding: 0 !important;\n    background: #fff;\n    border: 2px solid #9a9a9a;\n    cursor: pointer;\n    display: inline-grid;\n    place-content: center;\n    flex: 0 0 auto;\n  }\n\n  .kc-option-card input[type=\"checkbox\"] {\n    border-radius: 3px;\n  }\n\n  .kc-option-card input[type=\"radio\"] {\n    border-radius: 50%;\n  }\n\n  .kc-option-card input[type=\"checkbox\"]::before {\n    content: \"\";\n    width: 9px;\n    height: 5px;\n    border-left: 2px solid #202328;\n    border-bottom: 2px solid #202328;\n    transform: rotate(-45deg) scale(0);\n    transform-origin: center;\n  }\n\n  .kc-option-card input[type=\"checkbox\"]:checked {\n    background: #f5a000;\n    border-color: #f5a000;\n  }\n\n  .kc-option-card input[type=\"checkbox\"]:checked::before {\n    transform: rotate(-45deg) scale(1);\n  }\n\n  .kc-option-card input[type=\"radio\"]::before {\n    content: \"\";\n    width: 8px;\n    height: 8px;\n    border-radius: 50%;\n    background: #202328;\n    transform: scale(0);\n  }\n\n  .kc-option-card input[type=\"radio\"]:checked {\n    background: #f5a000;\n    border-color: #f5a000;\n  }\n\n  .kc-option-card input[type=\"radio\"]:checked::before {\n    transform: scale(1);\n  }\n\n  .kc-versions-box {\n    margin: 16px 0 0 30px;\n    padding: 18px;\n    background: #f7f7f7;\n    border-left: 3px solid #f5a000;\n  }\n\n  .kc-versions-title {\n    margin: 0 0 5px;\n    font-size: 15px;\n    font-weight: 700;\n  }\n\n  .kc-version-header,\n  .kc-version-row {\n    display: grid;\n    grid-template-columns: 2fr .7fr;\n    gap: 12px;\n  }\n\n  .kc-version-header {\n    margin: 16px 0 7px;\n    font-size: 11px;\n    font-weight: 700;\n    text-transform: uppercase;\n    letter-spacing: .05em;\n    color: #666;\n  }\n\n  .kc-version-row {\n    margin-bottom: 10px;\n  }\n\n  .kc-add-row {\n    border: 0;\n    background: transparent;\n    color: #202328;\n    padding: 6px 0;\n    font: inherit;\n    font-size: 14px;\n    font-weight: 700;\n    cursor: pointer;\n    text-decoration: underline;\n    text-underline-offset: 3px;\n  }\n\n  .kc-add-product {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    min-height: 44px;\n    margin-top: 15px;\n    border: 1px solid #202328;\n    border-radius: 3px;\n    background: #fff;\n    color: #202328;\n    padding: 8px 18px;\n    font: inherit;\n    font-size: 14px;\n    font-weight: 700;\n    cursor: pointer;\n  }\n\n  .kc-add-product:hover {\n    background: #f7f7f7;\n  }\n\n  .kc-hidden {\n    display: none !important;\n  }\n\n  .kc-date-wrap {\n    max-width: 420px;\n  }\n\n  .kc-reassurance {\n    margin: 5px 0 24px;\n    padding: 16px 18px;\n    border-left: 4px solid #f5a000;\n    background: #f7f7f7;\n    font-size: 14px;\n    line-height: 1.5;\n  }\n\n  .kc-submit-area {\n    text-align: center;\n  }\n\n  .kc-submit {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    min-height: 52px;\n    min-width: 260px;\n    border: 0;\n    border-radius: 3px;\n    padding: 13px 28px;\n    background: #f5a000;\n    color: #202328;\n    font: inherit;\n    font-size: 15px;\n    font-weight: 700;\n    cursor: pointer;\n  }\n\n  .kc-submit:hover {\n    opacity: .9;\n  }\n\n  .kc-submit-note {\n    max-width: 650px;\n    margin: 14px auto 0;\n    font-size: 13px;\n    color: #777;\n  }\n\n  .kc-errors {\n    margin-bottom: 24px;\n    border: 1px solid #e0b5ae;\n    border-radius: 4px;\n    padding: 16px 20px;\n    background: #fff5f3;\n  }\n\n  /* SUCCESS SCREEN */\n  .kc-success-screen {\n    max-width: 760px;\n    margin: 20px auto 10px;\n    padding: 52px 32px;\n    text-align: center;\n    background: #fff;\n    border: 1px solid #e2e2e2;\n    border-radius: 6px;\n  }\n\n  .kc-success-icon {\n    width: 58px;\n    height: 58px;\n    margin: 0 auto 18px;\n    border-radius: 50%;\n    background: #f5a000;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 30px;\n    font-weight: 700;\n    color: #202328;\n  }\n\n  .kc-success-screen h2 {\n    margin: 0 0 12px;\n    font-size: 30px;\n    line-height: 1.2;\n  }\n\n  .kc-success-screen > p {\n    max-width: 620px;\n    margin: 0 auto;\n    color: #666;\n    line-height: 1.7;\n    font-size: 16px;\n  }\n\n  .kc-success-steps {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 18px;\n    margin-top: 36px;\n    text-align: left;\n  }\n\n  .kc-success-step {\n    padding: 18px;\n    background: #f7f7f7;\n    border-top: 3px solid #f5a000;\n  }\n\n  .kc-success-step strong {\n    display: block;\n    margin-bottom: 6px;\n  }\n\n  .kc-success-step p {\n    margin: 0;\n    color: #666;\n    line-height: 1.5;\n    font-size: 14px;\n  }\n\n  .kc-success-contact {\n    margin-top: 28px;\n    font-size: 14px;\n  }\n\n  @media screen and (max-width: 749px) {\n    .kc-reorder {\n      padding: 20px 16px 40px;\n    }\n\n    .kc-reorder__intro h2 {\n      font-size: 27px;\n    }\n\n    .kc-grid,\n    .kc-product-row,\n    .kc-version-row,\n    .kc-success-steps {\n      grid-template-columns: 1fr;\n    }\n\n    .kc-version-header {\n      display: none;\n    }\n\n    .kc-versions-box {\n      margin-left: 0;\n    }\n\n    .kc-success-screen {\n      padding: 36px 20px;\n    }\n\n    .kc-success-screen h2 {\n      font-size: 25px;\n    }\n  }\n</style>\n\n\n<div class=\"kc-reorder\">\n\n  {% form 'contact', id: 'KegCollarsReorderForm' %}\n\n    {% if form.posted_successfully? %}\n\n      <div class=\"kc-success-screen\">\n\n        <div class=\"kc-success-icon\">✓</div>\n\n        <h2>Your Request Has Been Submitted</h2>\n\n        <p>\n          Thank you! We received your reorder request and will review your previous order,\n          artwork, quantities and any requested changes before anything goes into production.\n        </p>\n\n        <div class=\"kc-success-steps\">\n\n          <div class=\"kc-success-step\">\n            <strong>1. We Review</strong>\n            <p>\n              We'll locate your previous order and artwork.\n            </p>\n          </div>\n\n          <div class=\"kc-success-step\">\n            <strong>2. We Verify</strong>\n            <p>\n              We'll confirm quantities, pricing and requested changes.\n            </p>\n          </div>\n\n          <div class=\"kc-success-step\">\n            <strong>3. You Approve</strong>\n            <p>\n              Nothing prints until the reorder details are confirmed.\n            </p>\n          </div>\n\n        </div>\n\n        <div class=\"kc-success-contact\">\n          Questions? Email <strong>orders@kegcollars.net</strong>\n        </div>\n\n      </div>\n\n    {% else %}\n\n      <div class=\"kc-reorder__intro\">\n        <h2>Tell Us What You Need</h2>\n        <p>\n          Complete the information below and we'll locate your previous order,\n          verify your artwork and confirm everything before production.\n        </p>\n      </div>\n\n      {% if form.errors %}\n        <div class=\"kc-errors\">\n          {{ form.errors | default_errors }}\n        </div>\n      {% endif %}\n\n      <input\n        type=\"hidden\"\n        name=\"contact[Request Type]\"\n        value=\"REORDER REQUEST\"\n      >\n\n      <!-- 01 YOUR INFORMATION -->\n      <div class=\"kc-form-section\">\n\n        <div class=\"kc-section-heading\">\n          <span class=\"kc-section-number\">01</span>\n          <h3>Your Information</h3>\n        </div>\n\n        <div class=\"kc-grid\">\n\n          <div class=\"kc-field\">\n            <label for=\"kc-name\">\n              Full Name <span class=\"kc-required\">*</span>\n            </label>\n\n            <input\n              id=\"kc-name\"\n              type=\"text\"\n              name=\"contact[Full Name]\"\n              autocomplete=\"name\"\n              required\n            >\n          </div>\n\n          <div class=\"kc-field\">\n            <label for=\"kc-business\">\n              Business Name <span class=\"kc-required\">*</span>\n            </label>\n\n            <input\n              id=\"kc-business\"\n              type=\"text\"\n              name=\"contact[Business Name]\"\n              autocomplete=\"organization\"\n              required\n            >\n          </div>\n\n          <div class=\"kc-field\">\n            <label for=\"kc-email\">\n              Email Address <span class=\"kc-required\">*</span>\n            </label>\n\n            <input\n              id=\"kc-email\"\n              type=\"email\"\n              name=\"contact[email]\"\n              autocomplete=\"email\"\n              required\n            >\n          </div>\n\n          <div class=\"kc-field\">\n            <label for=\"kc-phone\">\n              Phone Number\n            </label>\n\n            <input\n              id=\"kc-phone\"\n              type=\"tel\"\n              name=\"contact[Phone]\"\n              autocomplete=\"tel\"\n            >\n          </div>\n\n        </div>\n      </div>\n\n      <!-- 02 REORDER DETAILS -->\n      <div class=\"kc-form-section\">\n\n        <div class=\"kc-section-heading\">\n          <span class=\"kc-section-number\">02</span>\n          <h3>What Are You Reordering?</h3>\n        </div>\n\n        <div class=\"kc-field\">\n          <label for=\"kc-order\">\n            Previous Order Number <span class=\"kc-required\">*</span>\n          </label>\n\n          <input\n            id=\"kc-order\"\n            type=\"text\"\n            name=\"contact[Previous Order Number]\"\n            placeholder=\"Example: #12345 or enter UNKNOWN\"\n            required\n          >\n\n          <p class=\"kc-help\">\n            Can't find it? Enter <strong>UNKNOWN</strong> and we'll look it up using your business name and email address.\n          </p>\n        </div>\n\n        <!-- PRODUCT 1 -->\n        <div class=\"kc-product-block\">\n\n          <p class=\"kc-product-block-title\">\n            Product\n          </p>\n\n          <div class=\"kc-product-row\">\n\n            <div class=\"kc-field\">\n              <label for=\"kc-product-1\">\n                Product <span class=\"kc-required\">*</span>\n              </label>\n\n              <select\n                id=\"kc-product-1\"\n                name=\"contact[Product 1]\"\n                required\n              >\n                <option value=\"\">Select a product</option>\n                <option value=\"Keg Collars\">Keg Collars</option>\n                <option value=\"Growler Tags\">Growler Tags</option>\n                <option value=\"Coasters\">Coasters</option>\n                <option value=\"Flight Cards\">Flight Cards</option>\n                <option value=\"Menus\">Menus</option>\n                <option value=\"Keg Caps\">Keg Caps</option>\n                <option value=\"Keg Wraps\">Keg Wraps</option>\n                <option value=\"Labels\">Labels</option>\n                <option value=\"Punch / Reward Cards\">Punch / Reward Cards</option>\n                <option value=\"Other\">Other</option>\n              </select>\n            </div>\n\n            <div class=\"kc-field\">\n              <label for=\"kc-quantity-1\">\n                Total Quantity <span class=\"kc-required\">*</span>\n              </label>\n\n              <input\n                id=\"kc-quantity-1\"\n                type=\"text\"\n                name=\"contact[Product 1 Quantity]\"\n                placeholder=\"Example: 2,000\"\n                required\n              >\n            </div>\n\n          </div>\n\n          <label class=\"kc-option-card\">\n\n            <input\n              type=\"checkbox\"\n              class=\"kc-version-toggle\"\n              data-product=\"1\"\n            >\n\n            <span>\n              <strong>This product has multiple versions or designs</strong>\n              For example: Hazy IPA, Pilsner and West Coast IPA.\n            </span>\n\n          </label>\n\n          <div\n            class=\"kc-versions-box kc-hidden\"\n            id=\"kc-versions-1\"\n          >\n\n            <p class=\"kc-versions-title\">\n              Versions for this product\n            </p>\n\n            <p class=\"kc-help\">\n              Tell us how the total quantity should be divided.\n            </p>\n\n            <div class=\"kc-version-header\">\n              <div>Version / Design</div>\n              <div>Quantity</div>\n            </div>\n\n            <div\n              class=\"kc-version-rows\"\n              data-product=\"1\"\n            >\n\n              <div class=\"kc-version-row\">\n                <input\n                  type=\"text\"\n                  name=\"contact[Product 1 - Version 1]\"\n                  placeholder=\"Example: Hazy IPA\"\n                  disabled\n                >\n\n                <input\n                  type=\"text\"\n                  name=\"contact[Product 1 - Version 1 Quantity]\"\n                  placeholder=\"500\"\n                  disabled\n                >\n              </div>\n\n              <div class=\"kc-version-row\">\n                <input\n                  type=\"text\"\n                  name=\"contact[Product 1 - Version 2]\"\n                  placeholder=\"Example: Pilsner\"\n                  disabled\n                >\n\n                <input\n                  type=\"text\"\n                  name=\"contact[Product 1 - Version 2 Quantity]\"\n                  placeholder=\"1,000\"\n                  disabled\n                >\n              </div>\n\n            </div>\n\n            <button\n              type=\"button\"\n              class=\"kc-add-row kc-add-version\"\n              data-product=\"1\"\n            >\n              + Add Another Version\n            </button>\n\n          </div>\n\n        </div>\n\n        <!-- MULTIPLE PRODUCTS -->\n        <label class=\"kc-option-card\">\n\n          <input\n            type=\"checkbox\"\n            id=\"kcMultipleProducts\"\n          >\n\n          <span>\n            <strong>This reorder includes another product type</strong>\n            For example: Keg Collars + Growler Tags + Coasters.\n          </span>\n\n        </label>\n\n        <div\n          id=\"kcAdditionalProductsArea\"\n          class=\"kc-hidden\"\n          style=\"margin-top:24px;\"\n        >\n\n          <div id=\"kcAdditionalProducts\"></div>\n\n          <button\n            type=\"button\"\n            class=\"kc-add-product\"\n            id=\"kcAddProduct\"\n          >\n            + ADD ANOTHER PRODUCT\n          </button>\n\n        </div>\n\n      </div>\n\n      <!-- ARTWORK -->\n      <div class=\"kc-form-section\">\n\n        <div class=\"kc-section-heading\">\n          <h3>Artwork &amp; Changes</h3>\n        </div>\n\n        <div class=\"kc-field\">\n\n          <span class=\"kc-field-label\">\n            Are there any changes from your previous order?\n            <span class=\"kc-required\">*</span>\n          </span>\n\n          <label class=\"kc-option-card\">\n\n            <input\n              type=\"radio\"\n              name=\"contact[Artwork Changes]\"\n              value=\"NO - Print exactly as previously ordered\"\n              required\n            >\n\n            <span>\n              <strong>No changes</strong>\n              Print exactly as previously ordered.\n            </span>\n\n          </label>\n\n          <label class=\"kc-option-card\">\n\n            <input\n              type=\"radio\"\n              name=\"contact[Artwork Changes]\"\n              value=\"YES - Changes are needed\"\n              required\n            >\n\n            <span>\n              <strong>Yes, changes are needed</strong>\n              I need to update information or artwork before printing.\n            </span>\n\n          </label>\n\n        </div>\n\n        <div\n          class=\"kc-field kc-hidden\"\n          id=\"kcChangeBox\"\n        >\n\n          <label for=\"kc-changes\">\n            Describe Your Changes\n          </label>\n\n          <textarea\n            id=\"kc-changes\"\n            name=\"contact[Requested Changes]\"\n            placeholder=\"Example: Change the ABV from 6.2% to 6.5%. Everything else stays the same.\"\n            disabled\n          ></textarea>\n\n        </div>\n\n      </div>\n\n      <!-- FINAL DETAILS -->\n      <div class=\"kc-form-section\">\n\n        <div class=\"kc-section-heading\">\n          <h3>Final Details</h3>\n        </div>\n\n        <div class=\"kc-field kc-date-wrap\">\n\n          <label for=\"kc-date\">\n            Requested In-Hand Date\n          </label>\n\n          <input\n            id=\"kc-date\"\n            type=\"date\"\n            name=\"contact[Requested In-Hand Date]\"\n          >\n\n          <p class=\"kc-help\">\n            We'll confirm production timing and delivery with your reorder.\n          </p>\n\n        </div>\n\n        <div class=\"kc-field\">\n\n          <label for=\"kc-notes\">\n            Additional Notes\n          </label>\n\n          <textarea\n            id=\"kc-notes\"\n            name=\"contact[Additional Notes]\"\n            placeholder=\"Deadlines, shipping instructions, special requests or anything else we should know.\"\n          ></textarea>\n\n        </div>\n\n      </div>\n\n      <div class=\"kc-reassurance\">\n        <strong>Nothing goes to production until we confirm your reorder.</strong>\n        We'll review your previous artwork, quantities, pricing and any requested changes before printing.\n      </div>\n\n      <div class=\"kc-submit-area\">\n\n        <button\n          type=\"submit\"\n          class=\"kc-submit\"\n        >\n          SUBMIT REORDER REQUEST →\n        </button>\n\n        <p class=\"kc-submit-note\">\n          Your reorder is not considered confirmed until a member of our team contacts you.\n        </p>\n\n      </div>\n\n    {% endif %}\n\n  {% endform %}\n\n</div>\n\n\n<script>\ndocument.addEventListener('DOMContentLoaded', function() {\n\n  var additionalArea = document.getElementById('kcAdditionalProductsArea');\n  var additionalProducts = document.getElementById('kcAdditionalProducts');\n  var multipleProductsToggle = document.getElementById('kcMultipleProducts');\n  var addProductButton = document.getElementById('kcAddProduct');\n\n  var productCount = 1;\n\n  var versionCounts = {\n    1: 2\n  };\n\n  function productOptions() {\n    return `\n      <option value=\"\">Select a product</option>\n      <option value=\"Keg Collars\">Keg Collars</option>\n      <option value=\"Growler Tags\">Growler Tags</option>\n      <option value=\"Coasters\">Coasters</option>\n      <option value=\"Flight Cards\">Flight Cards</option>\n      <option value=\"Menus\">Menus</option>\n      <option value=\"Keg Caps\">Keg Caps</option>\n      <option value=\"Keg Wraps\">Keg Wraps</option>\n      <option value=\"Labels\">Labels</option>\n      <option value=\"Punch / Reward Cards\">Punch / Reward Cards</option>\n      <option value=\"Other\">Other</option>\n    `;\n  }\n\n  function createProduct(productNumber) {\n\n    versionCounts[productNumber] = 2;\n\n    var block = document.createElement('div');\n    block.className = 'kc-product-block';\n    block.dataset.productBlock = productNumber;\n\n    block.innerHTML = `\n      <p class=\"kc-product-block-title\">\n        Additional Product ${productNumber}\n      </p>\n\n      <div class=\"kc-product-row\">\n\n        <div class=\"kc-field\">\n          <label>Product</label>\n\n          <select\n            name=\"contact[Product ${productNumber}]\"\n            required\n          >\n            ${productOptions()}\n          </select>\n        </div>\n\n        <div class=\"kc-field\">\n          <label>Total Quantity</label>\n\n          <input\n            type=\"text\"\n            name=\"contact[Product ${productNumber} Quantity]\"\n            placeholder=\"Example: 500\"\n            required\n          >\n        </div>\n\n      </div>\n\n      <label class=\"kc-option-card\">\n\n        <input\n          type=\"checkbox\"\n          class=\"kc-version-toggle\"\n          data-product=\"${productNumber}\"\n        >\n\n        <span>\n          <strong>This product has multiple versions or designs</strong>\n          Add versions and quantities for this product.\n        </span>\n\n      </label>\n\n      <div\n        class=\"kc-versions-box kc-hidden\"\n        id=\"kc-versions-${productNumber}\"\n      >\n\n        <p class=\"kc-versions-title\">\n          Versions for this product\n        </p>\n\n        <p class=\"kc-help\">\n          Tell us how the total quantity should be divided.\n        </p>\n\n        <div class=\"kc-version-header\">\n          <div>Version / Design</div>\n          <div>Quantity</div>\n        </div>\n\n        <div\n          class=\"kc-version-rows\"\n          data-product=\"${productNumber}\"\n        >\n\n          <div class=\"kc-version-row\">\n            <input\n              type=\"text\"\n              name=\"contact[Product ${productNumber} - Version 1]\"\n              placeholder=\"Version / Design\"\n              disabled\n            >\n\n            <input\n              type=\"text\"\n              name=\"contact[Product ${productNumber} - Version 1 Quantity]\"\n              placeholder=\"Quantity\"\n              disabled\n            >\n          </div>\n\n          <div class=\"kc-version-row\">\n            <input\n              type=\"text\"\n              name=\"contact[Product ${productNumber} - Version 2]\"\n              placeholder=\"Version / Design\"\n              disabled\n            >\n\n            <input\n              type=\"text\"\n              name=\"contact[Product ${productNumber} - Version 2 Quantity]\"\n              placeholder=\"Quantity\"\n              disabled\n            >\n          </div>\n\n        </div>\n\n        <button\n          type=\"button\"\n          class=\"kc-add-row kc-add-version\"\n          data-product=\"${productNumber}\"\n        >\n          + Add Another Version\n        </button>\n\n      </div>\n    `;\n\n    additionalProducts.appendChild(block);\n  }\n\n  function setVersionBox(productNumber, show) {\n\n    var box =\n      document.getElementById('kc-versions-' + productNumber);\n\n    if (!box) return;\n\n    var fields =\n      box.querySelectorAll('input');\n\n    if (show) {\n\n      box.classList.remove('kc-hidden');\n\n      fields.forEach(function(field) {\n        field.disabled = false;\n      });\n\n    } else {\n\n      box.classList.add('kc-hidden');\n\n      fields.forEach(function(field) {\n        field.disabled = true;\n        field.value = '';\n      });\n\n    }\n  }\n\n  document.addEventListener('change', function(event) {\n\n    if (\n      event.target.classList.contains('kc-version-toggle')\n    ) {\n\n      var productNumber =\n        event.target.dataset.product;\n\n      setVersionBox(\n        productNumber,\n        event.target.checked\n      );\n    }\n  });\n\n  document.addEventListener('click', function(event) {\n\n    if (\n      event.target.classList.contains('kc-add-version')\n    ) {\n\n      var productNumber =\n        event.target.dataset.product;\n\n      versionCounts[productNumber]++;\n\n      var versionNumber =\n        versionCounts[productNumber];\n\n      var rows =\n        document.querySelector(\n          '.kc-version-rows[data-product=\"' +\n          productNumber +\n          '\"]'\n        );\n\n      if (!rows) return;\n\n      var row =\n        document.createElement('div');\n\n      row.className =\n        'kc-version-row';\n\n      row.innerHTML = `\n        <input\n          type=\"text\"\n          name=\"contact[Product ${productNumber} - Version ${versionNumber}]\"\n          placeholder=\"Additional version\"\n        >\n\n        <input\n          type=\"text\"\n          name=\"contact[Product ${productNumber} - Version ${versionNumber} Quantity]\"\n          placeholder=\"Quantity\"\n        >\n      `;\n\n      rows.appendChild(row);\n    }\n  });\n\n  if (multipleProductsToggle) {\n\n    multipleProductsToggle.addEventListener(\n      'change',\n      function() {\n\n        if (this.checked) {\n\n          additionalArea.classList.remove(\n            'kc-hidden'\n          );\n\n          if (\n            additionalProducts.children.length === 0\n          ) {\n\n            productCount++;\n\n            createProduct(productCount);\n          }\n\n        } else {\n\n          additionalArea.classList.add(\n            'kc-hidden'\n          );\n\n          additionalProducts.innerHTML = '';\n\n          productCount = 1;\n\n          versionCounts = {\n            1: versionCounts[1] || 2\n          };\n        }\n      }\n    );\n  }\n\n  if (addProductButton) {\n\n    addProductButton.addEventListener(\n      'click',\n      function() {\n\n        productCount++;\n\n        createProduct(productCount);\n      }\n    );\n  }\n\n  var artworkRadios =\n    document.querySelectorAll(\n      'input[name=\"contact[Artwork Changes]\"]'\n    );\n\n  var changeBox =\n    document.getElementById('kcChangeBox');\n\n  var changeTextarea =\n    document.getElementById('kc-changes');\n\n  artworkRadios.forEach(function(radio) {\n\n    radio.addEventListener(\n      'change',\n      function() {\n\n        if (\n          this.value.indexOf('YES') === 0\n        ) {\n\n          changeBox.classList.remove(\n            'kc-hidden'\n          );\n\n          changeTextarea.disabled = false;\n\n        } else {\n\n          changeBox.classList.add(\n            'kc-hidden'\n          );\n\n          changeTextarea.disabled = true;\n\n          changeTextarea.value = '';\n        }\n      }\n    );\n  });\n\n});\n</script>",
        "color_scheme": "",
        "padding_top": 40,
        "padding_bottom": 52
      }
    }
  },
