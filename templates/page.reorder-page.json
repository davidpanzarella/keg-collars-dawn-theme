    "custom_liquid_TrGzmm": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n  .kc-reorder {\n    max-width: 980px;\n    margin: 0 auto;\n    padding: 24px 20px 50px;\n    color: #202328;\n  }\n\n  .kc-reorder__intro {\n    text-align: center;\n    max-width: 720px;\n    margin: 0 auto 34px;\n  }\n\n  .kc-reorder__intro h2 {\n    margin: 0 0 10px;\n    font-size: 32px;\n    line-height: 1.15;\n    font-weight: 700;\n    letter-spacing: -0.02em;\n  }\n\n  .kc-reorder__intro p {\n    margin: 0;\n    font-size: 16px;\n    line-height: 1.6;\n    color: #666;\n  }\n\n  .kc-form-section {\n    border-top: 1px solid #dedede;\n    padding: 30px 0;\n  }\n\n  .kc-form-section:first-of-type {\n    border-top: 0;\n    padding-top: 0;\n  }\n\n  .kc-section-heading {\n    display: flex;\n    align-items: center;\n    gap: 14px;\n    margin-bottom: 22px;\n  }\n\n  .kc-section-number {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    width: 34px;\n    height: 34px;\n    flex: 0 0 34px;\n    border-radius: 50%;\n    background: #f5a000;\n    color: #202328;\n    font-size: 14px;\n    font-weight: 700;\n  }\n\n  .kc-section-heading h3 {\n    margin: 0;\n    font-size: 21px;\n    line-height: 1.2;\n    font-weight: 700;\n  }\n\n  .kc-grid {\n    display: grid;\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    gap: 20px;\n  }\n\n  .kc-field {\n    margin-bottom: 20px;\n  }\n\n  .kc-field:last-child {\n    margin-bottom: 0;\n  }\n\n  .kc-field label,\n  .kc-field-label {\n    display: block;\n    margin-bottom: 7px;\n    font-size: 14px;\n    line-height: 1.4;\n    font-weight: 700;\n  }\n\n  .kc-required {\n    color: #c85032;\n  }\n\n  .kc-field input[type=\"text\"],\n  .kc-field input[type=\"email\"],\n  .kc-field input[type=\"tel\"],\n  .kc-field input[type=\"date\"],\n  .kc-field textarea,\n  .kc-order-row input {\n    width: 100%;\n    min-height: 48px;\n    box-sizing: border-box;\n    border: 1px solid #cfcfcf;\n    border-radius: 4px;\n    background: #fff;\n    color: #202328;\n    font: inherit;\n    padding: 11px 13px;\n  }\n\n  .kc-field textarea {\n    min-height: 115px;\n    resize: vertical;\n  }\n\n  .kc-field input:focus,\n  .kc-field textarea:focus,\n  .kc-order-row input:focus {\n    outline: none;\n    border-color: #f5a000;\n    box-shadow: 0 0 0 2px rgba(245,160,0,.16);\n  }\n\n  .kc-help {\n    margin: 7px 0 0;\n    font-size: 13px;\n    line-height: 1.5;\n    color: #777;\n  }\n\n  .kc-product-grid {\n    display: grid;\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    gap: 10px;\n    margin-top: 6px;\n  }\n\n  .kc-product-card {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    min-height: 48px;\n    border: 1px solid #d8d8d8;\n    border-radius: 4px;\n    padding: 10px 13px;\n    background: #fff;\n    cursor: pointer;\n  }\n\n  .kc-product-card:hover {\n    border-color: #f5a000;\n  }\n\n  .kc-product-card input[type=\"checkbox\"],\n  .kc-radio-card input[type=\"radio\"] {\n    appearance: auto !important;\n    -webkit-appearance: auto !important;\n    width: 16px !important;\n    height: 16px !important;\n    min-height: 0 !important;\n    margin: 0;\n    flex: 0 0 auto;\n    accent-color: #f5a000;\n  }\n\n  .kc-product-card span {\n    font-size: 14px;\n    font-weight: 600;\n  }\n\n  .kc-order-header,\n  .kc-order-row {\n    display: grid;\n    grid-template-columns: 2fr .7fr;\n    gap: 12px;\n  }\n\n  .kc-order-header {\n    margin-bottom: 7px;\n    font-size: 12px;\n    font-weight: 700;\n    text-transform: uppercase;\n    letter-spacing: .05em;\n    color: #666;\n  }\n\n  .kc-order-row {\n    margin-bottom: 10px;\n  }\n\n  .kc-add-row {\n    border: 0;\n    background: transparent;\n    color: #202328;\n    padding: 5px 0;\n    font: inherit;\n    font-size: 14px;\n    font-weight: 700;\n    cursor: pointer;\n    text-decoration: underline;\n    text-underline-offset: 3px;\n  }\n\n  .kc-radio-group {\n    display: grid;\n    gap: 10px;\n  }\n\n  .kc-radio-card {\n    display: flex;\n    align-items: flex-start;\n    gap: 10px;\n    border: 1px solid #d8d8d8;\n    border-radius: 4px;\n    padding: 14px 16px;\n    cursor: pointer;\n    background: #fff;\n  }\n\n  .kc-radio-card strong {\n    display: block;\n    margin-bottom: 2px;\n  }\n\n  .kc-change-box {\n    display: none;\n    margin-top: 18px;\n  }\n\n  .kc-date-wrap {\n    max-width: 420px;\n  }\n\n  .kc-reassurance {\n    margin: 5px 0 24px;\n    padding: 16px 18px;\n    border-left: 4px solid #f5a000;\n    background: #f7f7f7;\n    font-size: 14px;\n    line-height: 1.5;\n  }\n\n  .kc-reassurance strong {\n    color: #202328;\n  }\n\n  .kc-submit-area {\n    text-align: center;\n  }\n\n  .kc-submit {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    min-height: 52px;\n    min-width: 260px;\n    border: 0;\n    border-radius: 3px;\n    padding: 13px 28px;\n    background: #f5a000;\n    color: #202328;\n    font: inherit;\n    font-size: 15px;\n    font-weight: 700;\n    cursor: pointer;\n  }\n\n  .kc-submit:hover {\n    opacity: .9;\n  }\n\n  .kc-submit-note {\n    max-width: 650px;\n    margin: 14px auto 0;\n    font-size: 13px;\n    line-height: 1.5;\n    color: #777;\n  }\n\n  .kc-success {\n    margin: 20px 0 30px;\n    border: 1px solid #c9dfc7;\n    border-radius: 4px;\n    padding: 22px;\n    background: #f4faf3;\n    text-align: center;\n  }\n\n  .kc-errors {\n    margin-bottom: 24px;\n    border: 1px solid #e0b5ae;\n    border-radius: 4px;\n    padding: 16px 20px;\n    background: #fff5f3;\n  }\n\n  @media screen and (max-width: 749px) {\n    .kc-reorder {\n      padding: 20px 16px 40px;\n    }\n\n    .kc-grid,\n    .kc-product-grid {\n      grid-template-columns: 1fr;\n    }\n\n    .kc-order-header,\n    .kc-order-row {\n      grid-template-columns: 1fr;\n    }\n\n    .kc-order-header {\n      display: none;\n    }\n\n    .kc-order-row {\n      gap: 8px;\n      padding-bottom: 14px;\n      border-bottom: 1px solid #eee;\n    }\n  }\n</style>\n\n<div class=\"kc-reorder\">\n\n  <div class=\"kc-reorder__intro\">\n    <h2>Tell Us What You Need</h2>\n    <p>\n      Complete the information below and we'll locate your previous order,\n      verify your artwork and confirm everything before production.\n    </p>\n  </div>\n\n  {% form 'contact', id: 'KegCollarsReorderForm' %}\n\n    {% if form.posted_successfully? %}\n      <div class=\"kc-success\">\n        <h3>Reorder Request Received!</h3>\n        <p>\n          We'll review your previous order and artwork and contact you to confirm\n          pricing, production details and next steps.\n        </p>\n      </div>\n    {% endif %}\n\n    {% if form.errors %}\n      <div class=\"kc-errors\">\n        {{ form.errors | default_errors }}\n      </div>\n    {% endif %}\n\n    <input type=\"hidden\" name=\"contact[Request Type]\" value=\"REORDER REQUEST\">\n\n    <div class=\"kc-form-section\">\n      <div class=\"kc-section-heading\">\n        <span class=\"kc-section-number\">01</span>\n        <h3>Your Information</h3>\n      </div>\n\n      <div class=\"kc-grid\">\n        <div class=\"kc-field\">\n          <label for=\"kc-name\">Full Name <span class=\"kc-required\">*</span></label>\n          <input id=\"kc-name\" type=\"text\" name=\"contact[Full Name]\" required>\n        </div>\n\n        <div class=\"kc-field\">\n          <label for=\"kc-business\">Business Name <span class=\"kc-required\">*</span></label>\n          <input id=\"kc-business\" type=\"text\" name=\"contact[Business Name]\" required>\n        </div>\n\n        <div class=\"kc-field\">\n          <label for=\"kc-email\">Email Address <span class=\"kc-required\">*</span></label>\n          <input id=\"kc-email\" type=\"email\" name=\"contact[email]\" required>\n        </div>\n\n        <div class=\"kc-field\">\n          <label for=\"kc-phone\">Phone Number</label>\n          <input id=\"kc-phone\" type=\"tel\" name=\"contact[Phone]\">\n        </div>\n      </div>\n    </div>\n\n    <div class=\"kc-form-section\">\n      <div class=\"kc-section-heading\">\n        <span class=\"kc-section-number\">02</span>\n        <h3>Previous Order</h3>\n      </div>\n\n      <div class=\"kc-field\">\n        <label for=\"kc-order\">Previous Order Number <span class=\"kc-required\">*</span></label>\n        <input\n          id=\"kc-order\"\n          type=\"text\"\n          name=\"contact[Previous Order Number]\"\n          placeholder=\"Example: #12345 or enter UNKNOWN\"\n          required\n        >\n        <p class=\"kc-help\">\n          Can't find it? Enter <strong>UNKNOWN</strong> and we'll look it up using your business name and email address.\n        </p>\n      </div>\n\n      <div class=\"kc-field\">\n        <span class=\"kc-field-label\">\n          What are you reordering? <span class=\"kc-required\">*</span>\n        </span>\n\n        <div class=\"kc-product-grid\" id=\"kcProductGrid\">\n\n          <label class=\"kc-product-card\">\n            <input type=\"checkbox\" name=\"contact[Product - Keg Collars]\" value=\"Yes\">\n            <span>Keg Collars</span>\n          </label>\n\n          <label class=\"kc-product-card\">\n            <input type=\"checkbox\" name=\"contact[Product - Growler Tags]\" value=\"Yes\">\n            <span>Growler Tags</span>\n          </label>\n\n          <label class=\"kc-product-card\">\n            <input type=\"checkbox\" name=\"contact[Product - Coasters]\" value=\"Yes\">\n            <span>Coasters</span>\n          </label>\n\n          <label class=\"kc-product-card\">\n            <input type=\"checkbox\" name=\"contact[Product - Flight Cards]\" value=\"Yes\">\n            <span>Flight Cards</span>\n          </label>\n\n          <label class=\"kc-product-card\">\n            <input type=\"checkbox\" name=\"contact[Product - Menus]\" value=\"Yes\">\n            <span>Menus</span>\n          </label>\n\n          <label class=\"kc-product-card\">\n            <input type=\"checkbox\" name=\"contact[Product - Keg Caps]\" value=\"Yes\">\n            <span>Keg Caps</span>\n          </label>\n\n          <label class=\"kc-product-card\">\n            <input type=\"checkbox\" name=\"contact[Product - Keg Wraps]\" value=\"Yes\">\n            <span>Keg Wraps</span>\n          </label>\n\n          <label class=\"kc-product-card\">\n            <input type=\"checkbox\" name=\"contact[Product - Labels]\" value=\"Yes\">\n            <span>Labels</span>\n          </label>\n\n          <label class=\"kc-product-card\">\n            <input type=\"checkbox\" name=\"contact[Product - Punch Reward Cards]\" value=\"Yes\">\n            <span>Punch / Reward Cards</span>\n          </label>\n\n          <label class=\"kc-product-card\">\n            <input type=\"checkbox\" name=\"contact[Product - Other]\" value=\"Yes\">\n            <span>Other</span>\n          </label>\n\n        </div>\n      </div>\n    </div>\n\n    <div class=\"kc-form-section\">\n      <div class=\"kc-section-heading\">\n        <span class=\"kc-section-number\">03</span>\n        <h3>Versions &amp; Quantities</h3>\n      </div>\n\n      <p class=\"kc-help\" style=\"margin-bottom:18px;\">\n        List each specific beer, beverage, version or design and the quantity needed.\n      </p>\n\n      <div id=\"kcOrderRows\">\n\n        <div class=\"kc-order-header\">\n          <div>Version / Design</div>\n          <div>Quantity</div>\n        </div>\n\n        <div class=\"kc-order-row\">\n          <input type=\"text\" name=\"contact[Version 1]\" placeholder=\"Example: Hazy IPA\" required>\n          <input type=\"text\" name=\"contact[Quantity 1]\" placeholder=\"500\" required>\n        </div>\n\n        <div class=\"kc-order-row\">\n          <input type=\"text\" name=\"contact[Version 2]\" placeholder=\"Example: West Coast IPA\">\n          <input type=\"text\" name=\"contact[Quantity 2]\" placeholder=\"1,000\">\n        </div>\n\n        <div class=\"kc-order-row\">\n          <input type=\"text\" name=\"contact[Version 3]\" placeholder=\"Example: Pilsner\">\n          <input type=\"text\" name=\"contact[Quantity 3]\" placeholder=\"500\">\n        </div>\n\n      </div>\n\n      <button type=\"button\" class=\"kc-add-row\" id=\"kcAddRow\">\n        + Add Another Version\n      </button>\n\n      <div class=\"kc-field\" style=\"margin-top:26px;\">\n        <span class=\"kc-field-label\">\n          Are there any changes from your previous order?\n          <span class=\"kc-required\">*</span>\n        </span>\n\n        <div class=\"kc-radio-group\">\n          <label class=\"kc-radio-card\">\n            <input\n              type=\"radio\"\n              name=\"contact[Artwork Changes]\"\n              value=\"NO - Print exactly as previously ordered\"\n              required\n            >\n            <span>\n              <strong>No changes</strong>\n              Print exactly as previously ordered.\n            </span>\n          </label>\n\n          <label class=\"kc-radio-card\">\n            <input\n              type=\"radio\"\n              name=\"contact[Artwork Changes]\"\n              value=\"YES - Changes are needed\"\n              id=\"kcChangesYes\"\n              required\n            >\n            <span>\n              <strong>Yes, changes are needed</strong>\n              I need to update information or artwork before printing.\n            </span>\n          </label>\n        </div>\n\n        <div class=\"kc-change-box\" id=\"kcChangeBox\">\n          <label for=\"kc-changes\">Describe Any Changes</label>\n          <textarea\n            id=\"kc-changes\"\n            name=\"contact[Requested Changes]\"\n            placeholder=\"Example: Change the ABV on Hazy IPA from 6.2% to 6.5%. Everything else stays the same.\"\n          ></textarea>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"kc-form-section\">\n      <div class=\"kc-section-heading\">\n        <span class=\"kc-section-number\">04</span>\n        <h3>Final Details</h3>\n      </div>\n\n      <div class=\"kc-field kc-date-wrap\">\n        <label for=\"kc-date\">Requested In-Hand Date</label>\n        <input id=\"kc-date\" type=\"date\" name=\"contact[Requested In-Hand Date]\">\n        <p class=\"kc-help\">\n          We'll confirm production timing and delivery with your reorder.\n        </p>\n      </div>\n\n      <div class=\"kc-field\">\n        <label for=\"kc-notes\">Additional Notes</label>\n        <textarea\n          id=\"kc-notes\"\n          name=\"contact[Additional Notes]\"\n          placeholder=\"Deadlines, shipping instructions, additional versions, special requests or anything else we should know.\"\n        ></textarea>\n      </div>\n    </div>\n\n    <div class=\"kc-reassurance\">\n      <strong>Nothing goes to production until we confirm your reorder.</strong>\n      We'll review your previous artwork, quantities, pricing and any requested changes before printing.\n    </div>\n\n    <div class=\"kc-submit-area\">\n      <button type=\"submit\" class=\"kc-submit\">\n        SUBMIT REORDER REQUEST →\n      </button>\n\n      <p class=\"kc-submit-note\">\n        Your reorder is not considered confirmed until a member of our team contacts you.\n      </p>\n    </div>\n\n  {% endform %}\n\n</div>\n\n<script>\ndocument.addEventListener('DOMContentLoaded', function() {\n\n  var addRowButton = document.getElementById('kcAddRow');\n  var orderRows = document.getElementById('kcOrderRows');\n  var rowCount = 3;\n\n  if (addRowButton && orderRows) {\n    addRowButton.addEventListener('click', function() {\n\n      rowCount++;\n\n      var row = document.createElement('div');\n      row.className = 'kc-order-row';\n\n      row.innerHTML =\n        '<input type=\"text\" name=\"contact[Version ' + rowCount + ']\" placeholder=\"Additional version\">' +\n        '<input type=\"text\" name=\"contact[Quantity ' + rowCount + ']\" placeholder=\"Quantity\">';\n\n      orderRows.appendChild(row);\n    });\n  }\n\n  var radios = document.querySelectorAll('input[name=\"contact[Artwork Changes]\"]');\n  var changeBox = document.getElementById('kcChangeBox');\n\n  radios.forEach(function(radio) {\n    radio.addEventListener('change', function() {\n\n      if (this.value.indexOf('YES') === 0) {\n        changeBox.style.display = 'block';\n      } else {\n        changeBox.style.display = 'none';\n        document.getElementById('kc-changes').value = '';\n      }\n\n    });\n  });\n\n  var form = document.getElementById('KegCollarsReorderForm');\n\n  if (form) {\n    form.addEventListener('submit', function(event) {\n\n      var checkedProducts =\n        document.querySelectorAll('#kcProductGrid input[type=\"checkbox\"]:checked');\n\n      if (checkedProducts.length === 0) {\n        event.preventDefault();\n        alert('Please select at least one product you are reordering.');\n        document.getElementById('kcProductGrid').scrollIntoView({\n          behavior: 'smooth',\n          block: 'center'\n        });\n      }\n\n    });\n  }\n\n});\n</script>",
