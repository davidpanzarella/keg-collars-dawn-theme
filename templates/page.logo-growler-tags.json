    "custom_liquid_kxaCiY": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div class=\"logo-tag-form-wrapper\" id=\"personalize\">\n\n  <div class=\"logo-tag-form-header\">\n    <p class=\"eyebrow\">MAKE IT YOURS</p>\n    <h2>Personalize Your Growler Tags</h2>\n    <p>\n      Choose your design, provide your business information, and tell us how\n      you'd like your tags prepared. We'll send a digital proof before production.\n    </p>\n  </div>\n\n  {% form 'contact', id: 'logo-growler-tag-form' %}\n\n    {{ form.errors | default_errors }}\n\n    {% if form.posted_successfully? %}\n      <div class=\"form-success\">\n        <h3>Request Received!</h3>\n        <p>\n          Thanks for submitting your Logo Growler Tag information.\n          We'll review your details and prepare a digital proof for approval.\n        </p>\n      </div>\n    {% endif %}\n\n    <input\n      type=\"hidden\"\n      name=\"contact[request_type]\"\n      value=\"Logo Growler Tag Personalization\"\n    >\n\n    <!-- 1. CONTACT INFORMATION -->\n    <div class=\"form-section\">\n\n      <div class=\"section-number\">1</div>\n      <h3>Contact Information</h3>\n\n      <div class=\"form-grid two-column\">\n\n        <div class=\"field\">\n          <label for=\"logo-tag-first-name\">First Name <span>*</span></label>\n          <input\n            id=\"logo-tag-first-name\"\n            type=\"text\"\n            name=\"contact[first_name]\"\n            required\n          >\n        </div>\n\n        <div class=\"field\">\n          <label for=\"logo-tag-last-name\">Last Name <span>*</span></label>\n          <input\n            id=\"logo-tag-last-name\"\n            type=\"text\"\n            name=\"contact[last_name]\"\n            required\n          >\n        </div>\n\n      </div>\n\n      <div class=\"field\">\n        <label for=\"logo-tag-business\">Business Name <span>*</span></label>\n        <input\n          id=\"logo-tag-business\"\n          type=\"text\"\n          name=\"contact[business_name]\"\n          required\n        >\n      </div>\n\n      <div class=\"form-grid two-column\">\n\n        <div class=\"field\">\n          <label for=\"logo-tag-email\">Email Address <span>*</span></label>\n          <input\n            id=\"logo-tag-email\"\n            type=\"email\"\n            name=\"contact[email]\"\n            required\n          >\n        </div>\n\n        <div class=\"field\">\n          <label for=\"logo-tag-phone\">Phone Number <span>*</span></label>\n          <input\n            id=\"logo-tag-phone\"\n            type=\"tel\"\n            name=\"contact[phone]\"\n            required\n          >\n        </div>\n\n      </div>\n    </div>\n\n\n    <!-- 2. DESIGN SELECTION -->\n    <div class=\"form-section\">\n\n      <div class=\"section-number\">2</div>\n      <h3>Choose Your Design</h3>\n\n      <p class=\"section-helper\">\n        Select the growler tag design you would like us to personalize.\n      </p>\n\n      <div class=\"design-grid\">\n\n        <label class=\"option-card\">\n          <input\n            type=\"radio\"\n            name=\"contact[design_selection]\"\n            value=\"Beer Mug\"\n            required\n          >\n          <span>Beer Mug</span>\n        </label>\n\n        <label class=\"option-card\">\n          <input\n            type=\"radio\"\n            name=\"contact[design_selection]\"\n            value=\"Hops\"\n          >\n          <span>Hops</span>\n        </label>\n\n        <label class=\"option-card\">\n          <input\n            type=\"radio\"\n            name=\"contact[design_selection]\"\n            value=\"Kraft\"\n          >\n          <span>Kraft</span>\n        </label>\n\n        <label class=\"option-card\">\n          <input\n            type=\"radio\"\n            name=\"contact[design_selection]\"\n            value=\"Canvas\"\n          >\n          <span>Canvas</span>\n        </label>\n\n        <label class=\"option-card\">\n          <input\n            type=\"radio\"\n            name=\"contact[design_selection]\"\n            value=\"Chalkboard\"\n          >\n          <span>Chalkboard</span>\n        </label>\n\n        <label class=\"option-card\">\n          <input\n            type=\"radio\"\n            name=\"contact[design_selection]\"\n            value=\"Color Match\"\n          >\n          <span>Color Match</span>\n        </label>\n\n      </div>\n\n    </div>\n\n\n    <!-- 3. INFORMATION PRINTED ON TAG -->\n    <div class=\"form-section\">\n\n      <div class=\"section-number\">3</div>\n      <h3>Information to Print on Your Tag</h3>\n\n      <p class=\"section-helper\">\n        Enter the business information you want printed on the growler tag.\n      </p>\n\n      <div class=\"field\">\n        <label for=\"logo-tag-address\">Street Address <span>*</span></label>\n        <input\n          id=\"logo-tag-address\"\n          type=\"text\"\n          name=\"contact[tag_street_address]\"\n          required\n        >\n      </div>\n\n      <div class=\"form-grid three-column\">\n\n        <div class=\"field\">\n          <label for=\"logo-tag-city\">City <span>*</span></label>\n          <input\n            id=\"logo-tag-city\"\n            type=\"text\"\n            name=\"contact[tag_city]\"\n            required\n          >\n        </div>\n\n        <div class=\"field\">\n          <label for=\"logo-tag-state\">State <span>*</span></label>\n          <input\n            id=\"logo-tag-state\"\n            type=\"text\"\n            name=\"contact[tag_state]\"\n            required\n          >\n        </div>\n\n        <div class=\"field\">\n          <label for=\"logo-tag-zip\">ZIP <span>*</span></label>\n          <input\n            id=\"logo-tag-zip\"\n            type=\"text\"\n            name=\"contact[tag_zip]\"\n            required\n          >\n        </div>\n\n      </div>\n\n      <div class=\"form-grid two-column\">\n\n        <div class=\"field\">\n          <label for=\"logo-tag-print-phone\">Phone Number to Print on Tag</label>\n          <input\n            id=\"logo-tag-print-phone\"\n            type=\"tel\"\n            name=\"contact[tag_phone]\"\n          >\n        </div>\n\n        <div class=\"field\">\n          <label for=\"logo-tag-website\">Website</label>\n          <input\n            id=\"logo-tag-website\"\n            type=\"text\"\n            name=\"contact[tag_website]\"\n          >\n        </div>\n\n      </div>\n\n    </div>\n\n\n    <!-- 4. GOVERNMENT WARNING -->\n    <div class=\"form-section\">\n\n      <div class=\"section-number\">4</div>\n      <h3>Government Warning</h3>\n\n      <p class=\"section-helper\">\n        Should the Government Warning be included on your growler tag?\n      </p>\n\n      <div class=\"warning-grid\">\n\n        <label class=\"option-card option-card-tall\">\n          <input\n            type=\"radio\"\n            name=\"contact[government_warning]\"\n            value=\"Include Government Warning\"\n            required\n          >\n\n          <span>\n            <strong>Include Warning</strong>\n            <small>\n              Include the standard alcoholic beverage Government Warning.\n            </small>\n          </span>\n        </label>\n\n        <label class=\"option-card option-card-tall\">\n          <input\n            type=\"radio\"\n            name=\"contact[government_warning]\"\n            value=\"Do Not Include Government Warning\"\n          >\n\n          <span>\n            <strong>Do Not Include</strong>\n            <small>\n              For non-alcoholic products or when the warning is not required.\n            </small>\n          </span>\n        </label>\n\n      </div>\n\n    </div>\n\n\n    <!-- 5. LOGO & ARTWORK -->\n    <div class=\"form-section\">\n\n      <div class=\"section-number\">5</div>\n      <h3>Logo & Artwork</h3>\n\n      <p class=\"section-helper\">\n        Tell us how you'd like your branding handled. We'll collect your logo file\n        separately before artwork is prepared.\n      </p>\n\n      <div class=\"field\">\n        <label for=\"logo-tag-art-instructions\">\n          Logo / Color Instructions\n        </label>\n\n        <textarea\n          id=\"logo-tag-art-instructions\"\n          name=\"contact[logo_color_instructions]\"\n          rows=\"4\"\n          placeholder=\"Example: Use our logo as supplied, match our navy and gold brand colors, etc.\"\n        ></textarea>\n      </div>\n\n      <div class=\"artwork-note\">\n        <strong>Logo Upload:</strong>\n        We’ll add the file-upload step next so your logo arrives with this request.\n      </div>\n\n    </div>\n\n\n    <!-- 6. ADDITIONAL INSTRUCTIONS -->\n    <div class=\"form-section\">\n\n      <div class=\"section-number\">6</div>\n      <h3>Additional Instructions</h3>\n\n      <div class=\"field\">\n        <label for=\"logo-tag-notes\">Anything else we should know?</label>\n\n        <textarea\n          id=\"logo-tag-notes\"\n          name=\"contact[body]\"\n          rows=\"6\"\n          placeholder=\"Special wording, changes to the selected design, production notes, or anything else you'd like us to know.\"\n        ></textarea>\n      </div>\n\n    </div>\n\n\n    <!-- SUBMIT -->\n    <div class=\"form-submit\">\n\n      <button type=\"submit\">\n        Submit My Personalization Request →\n      </button>\n\n      <p>\n        We'll send a digital proof for approval before production.\n      </p>\n\n    </div>\n\n  {% endform %}\n\n</div>\n\n\n<style>\n\n.logo-tag-form-wrapper {\n  max-width: 980px;\n  margin: 0 auto;\n  padding: 60px 24px 70px;\n  box-sizing: border-box;\n}\n\n.logo-tag-form-header {\n  max-width: 760px;\n  margin: 0 auto 40px;\n  text-align: center;\n}\n\n.logo-tag-form-header .eyebrow {\n  margin: 0 0 8px;\n  color: #f59c00;\n  font-size: 12px;\n  font-weight: 700;\n  letter-spacing: .16em;\n}\n\n.logo-tag-form-header h2 {\n  margin: 0 0 14px;\n  font-size: 40px;\n  line-height: 1.15;\n}\n\n.logo-tag-form-header p {\n  margin: 0 auto;\n  color: #626262;\n  font-size: 16px;\n  line-height: 1.6;\n}\n\n.form-section {\n  position: relative;\n  margin-bottom: 22px;\n  padding: 30px;\n  background: #f8f6f0;\n  border: 1px solid #dedbd2;\n  border-radius: 12px;\n  box-sizing: border-box;\n}\n\n.form-section h3 {\n  margin: 0 0 18px;\n  font-size: 23px;\n  line-height: 1.25;\n}\n\n.section-number {\n  display: inline-flex;\n  width: 28px;\n  height: 28px;\n  margin-bottom: 10px;\n  align-items: center;\n  justify-content: center;\n  border-radius: 50%;\n  background: #f59c00;\n  color: #111;\n  font-size: 13px;\n  font-weight: 700;\n}\n\n.section-helper {\n  margin: -5px 0 20px;\n  color: #666;\n  font-size: 14px;\n  line-height: 1.5;\n}\n\n.form-grid {\n  display: grid;\n  gap: 18px;\n  align-items: start;\n}\n\n.two-column {\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n}\n\n.three-column {\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n}\n\n.field {\n  display: block !important;\n  margin: 0 0 18px !important;\n}\n\n.field label {\n  display: block !important;\n  position: static !important;\n  width: auto !important;\n  height: auto !important;\n  margin: 0 0 7px !important;\n  padding: 0 !important;\n  transform: none !important;\n  background: transparent !important;\n  color: #25282b !important;\n  font-size: 14px !important;\n  line-height: 1.3 !important;\n  font-weight: 600 !important;\n}\n\n.field label span {\n  color: #c35422;\n}\n\n.field input,\n.field textarea,\n.field select {\n  display: block !important;\n  width: 100% !important;\n  margin: 0 !important;\n  padding: 12px 14px !important;\n  box-sizing: border-box !important;\n  border: 1px solid #c9c6bd !important;\n  border-radius: 6px !important;\n  background: #fff !important;\n  color: #25282b !important;\n  font: inherit !important;\n  font-size: 15px !important;\n  box-shadow: none !important;\n}\n\n.field input {\n  min-height: 48px !important;\n}\n\n.field textarea {\n  min-height: 120px !important;\n  resize: vertical;\n}\n\n.field input:focus,\n.field textarea:focus {\n  outline: none !important;\n  border-color: #f59c00 !important;\n  box-shadow: 0 0 0 2px rgba(245, 156, 0, .12) !important;\n}\n\n.design-grid {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 12px;\n}\n\n.warning-grid {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 12px;\n}\n\n.option-card {\n  display: flex;\n  min-height: 62px;\n  padding: 16px;\n  gap: 10px;\n  align-items: center;\n  box-sizing: border-box;\n  border: 1px solid #d3d0c7;\n  border-radius: 8px;\n  background: #fff;\n  cursor: pointer;\n  transition: border-color .15s ease, background .15s ease;\n}\n\n.option-card:hover {\n  border-color: #f59c00;\n}\n\n.option-card input {\n  flex: 0 0 auto;\n  margin: 1px 0 0;\n  accent-color: #f59c00;\n}\n\n.option-card span {\n  display: block;\n  color: #333;\n  font-size: 14px;\n  font-weight: 600;\n  line-height: 1.35;\n}\n\n.option-card strong {\n  display: block;\n  margin-bottom: 4px;\n}\n\n.option-card small {\n  display: block;\n  color: #686868;\n  font-size: 12px;\n  font-weight: 400;\n  line-height: 1.45;\n}\n\n.option-card-tall {\n  align-items: flex-start;\n  min-height: 88px;\n}\n\n.option-card:has(input:checked) {\n  border: 2px solid #f59c00;\n  background: #fffaf0;\n}\n\n.artwork-note {\n  margin-top: 4px;\n  padding: 14px 16px;\n  border-left: 4px solid #f59c00;\n  border-radius: 4px;\n  background: #fff;\n  color: #555;\n  font-size: 13px;\n  line-height: 1.5;\n}\n\n.form-submit {\n  padding-top: 8px;\n  text-align: center;\n}\n\n.form-submit button {\n  min-height: 52px;\n  padding: 14px 28px;\n  border: 0;\n  border-radius: 7px;\n  background: #f59c00;\n  color: #111;\n  font-size: 16px;\n  font-weight: 700;\n  cursor: pointer;\n}\n\n.form-submit button:hover {\n  filter: brightness(.95);\n}\n\n.form-submit p {\n  margin: 12px 0 0;\n  color: #666;\n  font-size: 13px;\n}\n\n.form-success {\n  margin-bottom: 24px;\n  padding: 20px;\n  border: 1px solid #bdd4b7;\n  border-radius: 8px;\n  background: #eff7ed;\n}\n\n.form-success h3 {\n  margin: 0 0 5px;\n}\n\n.form-success p {\n  margin: 0;\n}\n\n@media screen and (max-width: 749px) {\n\n  .logo-tag-form-wrapper {\n    padding: 42px 16px 55px;\n  }\n\n  .logo-tag-form-header h2 {\n    font-size: 31px;\n  }\n\n  .form-section {\n    padding: 22px 18px;\n  }\n\n  .two-column,\n  .three-column,\n  .design-grid,\n  .warning-grid {\n    grid-template-columns: 1fr;\n  }\n\n}\n\n</style>",
