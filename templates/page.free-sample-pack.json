    "custom_liquid_TrGzmm": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n  .kc-samples {\n    max-width: 980px;\n    margin: 0 auto;\n    padding: 24px 20px 50px;\n    color: #202328;\n  }\n\n  .kc-samples__intro {\n    text-align: center;\n    max-width: 760px;\n    margin: 0 auto 38px;\n  }\n\n  .kc-samples__intro h2 {\n    margin: 0 0 10px;\n    font-size: 32px;\n    line-height: 1.15;\n    font-weight: 700;\n  }\n\n  .kc-samples__intro p {\n    margin: 0;\n    font-size: 16px;\n    line-height: 1.6;\n    color: #666;\n  }\n\n  .kc-form-section {\n    border-top: 1px solid #dedede;\n    padding: 32px 0;\n  }\n\n  .kc-form-section:first-of-type {\n    border-top: 0;\n    padding-top: 0;\n  }\n\n  .kc-section-heading {\n    display: flex;\n    align-items: center;\n    gap: 14px;\n    margin-bottom: 22px;\n  }\n\n  .kc-section-number {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    width: 34px;\n    height: 34px;\n    flex: 0 0 34px;\n    border-radius: 50%;\n    background: #f5a000;\n    color: #202328;\n    font-size: 14px;\n    font-weight: 700;\n  }\n\n  .kc-section-heading h3 {\n    margin: 0;\n    font-size: 21px;\n    line-height: 1.2;\n    font-weight: 700;\n  }\n\n  .kc-section-copy {\n    margin: -10px 0 22px 48px;\n    color: #666;\n    font-size: 14px;\n    line-height: 1.5;\n  }\n\n  .kc-pack-grid {\n    display: grid;\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    gap: 16px;\n  }\n\n  .kc-pack-card {\n    position: relative;\n    display: block;\n    min-height: 270px;\n    box-sizing: border-box;\n    border: 2px solid #dedede;\n    border-radius: 6px;\n    background: #fff;\n    padding: 24px 22px 22px;\n    cursor: pointer;\n    transition: border-color .15s ease, background .15s ease, transform .15s ease;\n  }\n\n  .kc-pack-card:hover {\n    border-color: #f5a000;\n    transform: translateY(-2px);\n  }\n\n  .kc-pack-card input {\n    position: absolute;\n    opacity: 0;\n    pointer-events: none;\n  }\n\n  .kc-pack-check {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    width: 26px;\n    height: 26px;\n    margin-bottom: 18px;\n    border: 2px solid #b5b5b5;\n    border-radius: 50%;\n    background: #fff;\n  }\n\n  .kc-pack-check::after {\n    content: \"\";\n    width: 8px;\n    height: 5px;\n    border-left: 2px solid #202328;\n    border-bottom: 2px solid #202328;\n    transform: rotate(-45deg) scale(0);\n    transition: transform .12s ease;\n  }\n\n  .kc-pack-card:has(input:checked) {\n    border-color: #f5a000;\n    background: #fffaf0;\n  }\n\n  .kc-pack-card:has(input:checked) .kc-pack-check {\n    background: #f5a000;\n    border-color: #f5a000;\n  }\n\n  .kc-pack-card:has(input:checked) .kc-pack-check::after {\n    transform: rotate(-45deg) scale(1);\n  }\n\n  .kc-pack-label {\n    display: inline-block;\n    margin-bottom: 9px;\n    font-size: 11px;\n    line-height: 1.2;\n    font-weight: 700;\n    letter-spacing: .08em;\n    text-transform: uppercase;\n    color: #777;\n  }\n\n  .kc-pack-card h4 {\n    margin: 0 0 7px;\n    font-size: 19px;\n    line-height: 1.25;\n    font-weight: 700;\n  }\n\n  .kc-pack-for {\n    margin: 0 0 17px;\n    min-height: 40px;\n    font-size: 13px;\n    line-height: 1.5;\n    color: #777;\n  }\n\n  .kc-pack-products {\n    margin: 0;\n    padding: 0;\n    list-style: none;\n  }\n\n  .kc-pack-products li {\n    position: relative;\n    margin: 7px 0;\n    padding-left: 17px;\n    font-size: 14px;\n    line-height: 1.4;\n  }\n\n  .kc-pack-products li::before {\n    content: \"✓\";\n    position: absolute;\n    left: 0;\n    top: 0;\n    font-weight: 700;\n    color: #f5a000;\n  }\n\n  .kc-pack-complete {\n    border-color: #c9c9c9;\n  }\n\n  .kc-pack-complete .kc-pack-label {\n    color: #a36a00;\n  }\n\n  .kc-grid {\n    display: grid;\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    gap: 20px;\n  }\n\n  .kc-address-grid {\n    display: grid;\n    grid-template-columns: 1.5fr .7fr .7fr;\n    gap: 20px;\n  }\n\n  .kc-field {\n    margin-bottom: 20px;\n  }\n\n  .kc-field:last-child {\n    margin-bottom: 0;\n  }\n\n  .kc-field label {\n    display: block;\n    margin-bottom: 7px;\n    font-size: 14px;\n    line-height: 1.4;\n    font-weight: 700;\n    color: #202328;\n  }\n\n  .kc-required {\n    color: #c85032;\n  }\n\n  .kc-field input[type=\"text\"],\n  .kc-field input[type=\"email\"],\n  .kc-field input[type=\"tel\"],\n  .kc-field select,\n  .kc-field textarea {\n    width: 100%;\n    min-height: 48px;\n    box-sizing: border-box;\n    border: 1px solid #cfcfcf;\n    border-radius: 4px;\n    background: #fff;\n    color: #202328;\n    font: inherit;\n    padding: 11px 13px;\n    box-shadow: none;\n  }\n\n  .kc-field textarea {\n    min-height: 120px;\n    resize: vertical;\n  }\n\n  .kc-field input:focus,\n  .kc-field select:focus,\n  .kc-field textarea:focus {\n    outline: none;\n    border-color: #f5a000;\n    box-shadow: 0 0 0 2px rgba(245,160,0,.16);\n  }\n\n  .kc-help {\n    margin: 7px 0 0;\n    font-size: 13px;\n    line-height: 1.5;\n    color: #777;\n  }\n\n  .kc-us-only {\n    margin: -8px 0 24px 48px;\n    padding: 12px 14px;\n    background: #fffaf0;\n    border-left: 3px solid #f5a000;\n    font-size: 13px;\n    line-height: 1.5;\n    color: #555;\n  }\n\n  .kc-reassurance {\n    margin: 4px 0 25px;\n    padding: 17px 19px;\n    border-left: 4px solid #f5a000;\n    background: #f7f7f7;\n    font-size: 14px;\n    line-height: 1.55;\n  }\n\n  .kc-submit-area {\n    text-align: center;\n  }\n\n  .kc-submit {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    min-height: 52px;\n    min-width: 290px;\n    border: 0;\n    border-radius: 3px;\n    padding: 13px 28px;\n    background: #f5a000;\n    color: #202328;\n    font: inherit;\n    font-size: 15px;\n    font-weight: 700;\n    cursor: pointer;\n  }\n\n  .kc-submit:hover {\n    opacity: .9;\n  }\n\n  .kc-submit-note {\n    max-width: 650px;\n    margin: 14px auto 0;\n    font-size: 13px;\n    line-height: 1.5;\n    color: #777;\n  }\n\n  .kc-errors {\n    margin-bottom: 24px;\n    border: 1px solid #e0b5ae;\n    border-radius: 4px;\n    padding: 16px 20px;\n    background: #fff5f3;\n  }\n\n  .kc-success-screen {\n    max-width: 760px;\n    margin: 20px auto 10px;\n    padding: 52px 32px;\n    text-align: center;\n    background: #fff;\n    border: 1px solid #e2e2e2;\n    border-radius: 6px;\n  }\n\n  .kc-success-icon {\n    width: 58px;\n    height: 58px;\n    margin: 0 auto 18px;\n    border-radius: 50%;\n    background: #f5a000;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 30px;\n    font-weight: 700;\n    color: #202328;\n  }\n\n  .kc-success-screen h2 {\n    margin: 0 0 12px;\n    font-size: 30px;\n    line-height: 1.2;\n  }\n\n  .kc-success-screen > p {\n    max-width: 620px;\n    margin: 0 auto;\n    color: #666;\n    line-height: 1.7;\n    font-size: 16px;\n  }\n\n  .kc-success-steps {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 18px;\n    margin-top: 36px;\n    text-align: left;\n  }\n\n  .kc-success-step {\n    padding: 18px;\n    background: #f7f7f7;\n    border-top: 3px solid #f5a000;\n  }\n\n  .kc-success-step strong {\n    display: block;\n    margin-bottom: 6px;\n  }\n\n  .kc-success-step p {\n    margin: 0;\n    color: #666;\n    line-height: 1.5;\n    font-size: 14px;\n  }\n\n  .kc-success-contact {\n    margin-top: 28px;\n    font-size: 14px;\n  }\n\n  @media screen and (max-width: 850px) {\n    .kc-pack-grid {\n      grid-template-columns: 1fr;\n    }\n\n    .kc-pack-card {\n      min-height: 0;\n    }\n\n    .kc-pack-for {\n      min-height: 0;\n    }\n  }\n\n  @media screen and (max-width: 749px) {\n    .kc-samples {\n      padding: 20px 16px 40px;\n    }\n\n    .kc-samples__intro h2 {\n      font-size: 27px;\n    }\n\n    .kc-grid,\n    .kc-address-grid,\n    .kc-success-steps {\n      grid-template-columns: 1fr;\n      gap: 0;\n    }\n\n    .kc-section-copy,\n    .kc-us-only {\n      margin-left: 0;\n    }\n\n    .kc-success-screen {\n      padding: 36px 20px;\n    }\n\n    .kc-success-screen h2 {\n      font-size: 25px;\n    }\n  }\n</style>\n\n<div class=\"kc-samples\">\n\n  {% form 'contact', id: 'KegCollarsSampleForm' %}\n\n    {% if form.posted_successfully? %}\n\n      <div class=\"kc-success-screen\">\n\n        <div class=\"kc-success-icon\">✓</div>\n\n        <h2>Your Sample Request Has Been Submitted</h2>\n\n        <p>\n          Thank you! We've received your request and will put together a selection\n          of printed KegCollars.net samples for you.\n        </p>\n\n        <div class=\"kc-success-steps\">\n\n          <div class=\"kc-success-step\">\n            <strong>1. We Review</strong>\n            <p>We'll review your request and the sample pack you selected.</p>\n          </div>\n\n          <div class=\"kc-success-step\">\n            <strong>2. We Pack</strong>\n            <p>We'll gather a representative selection of printed products.</p>\n          </div>\n\n          <div class=\"kc-success-step\">\n            <strong>3. We Ship</strong>\n            <p>Your sample pack will be sent to the shipping address provided.</p>\n          </div>\n\n        </div>\n\n        <div class=\"kc-success-contact\">\n          Questions? Email <strong>orders@kegcollars.net</strong>\n        </div>\n\n      </div>\n\n    {% else %}\n\n      <div class=\"kc-samples__intro\">\n        <h2>Choose Your Free Sample Pack</h2>\n\n        <p>\n          Select the products you'd like to see. We'll send professionally printed\n          samples so you can see the materials, print quality and finished products firsthand.\n        </p>\n      </div>\n\n      {% if form.errors %}\n        <div class=\"kc-errors\">\n          {{ form.errors | default_errors }}\n        </div>\n      {% endif %}\n\n      <input\n        type=\"hidden\"\n        name=\"contact[Request Type]\"\n        value=\"FREE SAMPLE PACK REQUEST\"\n      >\n\n      <input\n        type=\"hidden\"\n        name=\"contact[Country]\"\n        value=\"United States\"\n      >\n\n      <!-- 01 CHOOSE SAMPLE PACK -->\n\n      <div class=\"kc-form-section\">\n\n        <div class=\"kc-section-heading\">\n          <span class=\"kc-section-number\">01</span>\n          <h3>Choose Your Sample Pack</h3>\n        </div>\n\n        <p class=\"kc-section-copy\">\n          Choose the pack that best matches the products you're considering.\n        </p>\n\n        <div class=\"kc-pack-grid\">\n\n          <label class=\"kc-pack-card\">\n\n            <input\n              type=\"radio\"\n              name=\"contact[Sample Pack]\"\n              value=\"Production Sample Pack\"\n              required\n            >\n\n            <span class=\"kc-pack-check\"></span>\n\n            <span class=\"kc-pack-label\">Beverage Production</span>\n\n            <h4>Production Sample Pack</h4>\n\n            <p class=\"kc-pack-for\">\n              For breweries and beverage producers.\n            </p>\n\n            <ul class=\"kc-pack-products\">\n              <li>Keg Collars</li>\n              <li>Keg Wraps</li>\n              <li>Keg Caps</li>\n              <li>Labels</li>\n            </ul>\n\n          </label>\n\n          <label class=\"kc-pack-card\">\n\n            <input\n              type=\"radio\"\n              name=\"contact[Sample Pack]\"\n              value=\"Taproom & Hospitality Sample Pack\"\n              required\n            >\n\n            <span class=\"kc-pack-check\"></span>\n\n            <span class=\"kc-pack-label\">Front of House</span>\n\n            <h4>Taproom &amp; Hospitality Sample Pack</h4>\n\n            <p class=\"kc-pack-for\">\n              For taprooms, restaurants and hospitality.\n            </p>\n\n            <ul class=\"kc-pack-products\">\n              <li>Growler Tags</li>\n              <li>Coasters</li>\n              <li>Flight Cards</li>\n              <li>Menus</li>\n              <li>Cup Sleeves</li>\n            </ul>\n\n          </label>\n\n          <label class=\"kc-pack-card kc-pack-complete\">\n\n            <input\n              type=\"radio\"\n              name=\"contact[Sample Pack]\"\n              value=\"Complete Sample Pack\"\n              required\n            >\n\n            <span class=\"kc-pack-check\"></span>\n\n            <span class=\"kc-pack-label\">See It All</span>\n\n            <h4>Complete Sample Pack</h4>\n\n            <p class=\"kc-pack-for\">\n              A broader selection from both sample packs.\n            </p>\n\n            <ul class=\"kc-pack-products\">\n              <li>Production Samples</li>\n              <li>Taproom Samples</li>\n              <li>Hospitality Samples</li>\n              <li>Variety of Materials</li>\n            </ul>\n\n          </label>\n\n        </div>\n\n      </div>\n\n      <!-- 02 YOUR INFORMATION -->\n\n      <div class=\"kc-form-section\">\n\n        <div class=\"kc-section-heading\">\n          <span class=\"kc-section-number\">02</span>\n          <h3>Your Information</h3>\n        </div>\n\n        <div class=\"kc-grid\">\n\n          <div class=\"kc-field\">\n            <label for=\"kc-sample-name\">\n              Full Name <span class=\"kc-required\">*</span>\n            </label>\n\n            <input\n              id=\"kc-sample-name\"\n              type=\"text\"\n              name=\"contact[Full Name]\"\n              autocomplete=\"name\"\n              required\n            >\n          </div>\n\n          <div class=\"kc-field\">\n            <label for=\"kc-sample-business\">\n              Business Name <span class=\"kc-required\">*</span>\n            </label>\n\n            <input\n              id=\"kc-sample-business\"\n              type=\"text\"\n              name=\"contact[Business Name]\"\n              autocomplete=\"organization\"\n              required\n            >\n          </div>\n\n          <div class=\"kc-field\">\n            <label for=\"kc-sample-email\">\n              Email Address <span class=\"kc-required\">*</span>\n            </label>\n\n            <input\n              id=\"kc-sample-email\"\n              type=\"email\"\n              name=\"contact[email]\"\n              autocomplete=\"email\"\n              required\n            >\n          </div>\n\n          <div class=\"kc-field\">\n            <label for=\"kc-sample-phone\">Phone Number</label>\n\n            <input\n              id=\"kc-sample-phone\"\n              type=\"tel\"\n              name=\"contact[Phone]\"\n              autocomplete=\"tel\"\n            >\n          </div>\n\n        </div>\n\n        <div class=\"kc-field\">\n\n          <label for=\"kc-business-type\">\n            Business Type <span class=\"kc-required\">*</span>\n          </label>\n\n          <select\n            id=\"kc-business-type\"\n            name=\"contact[Business Type]\"\n            required\n          >\n            <option value=\"\">Select your business type</option>\n            <option value=\"Brewery\">Brewery</option>\n            <option value=\"Cidery\">Cidery</option>\n            <option value=\"Winery\">Winery</option>\n            <option value=\"Distillery\">Distillery</option>\n            <option value=\"Kombucha\">Kombucha</option>\n            <option value=\"Coffee\">Coffee</option>\n            <option value=\"Restaurant / Bar\">Restaurant / Bar</option>\n            <option value=\"Hotel / Hospitality\">Hotel / Hospitality</option>\n            <option value=\"Distributor\">Distributor</option>\n            <option value=\"Other\">Other</option>\n          </select>\n\n        </div>\n\n      </div>\n\n      <!-- 03 SHIPPING -->\n\n      <div class=\"kc-form-section\">\n\n        <div class=\"kc-section-heading\">\n          <span class=\"kc-section-number\">03</span>\n          <h3>Where Should We Send Your Samples?</h3>\n        </div>\n\n        <div class=\"kc-us-only\">\n          <strong>U.S. shipping addresses only.</strong>\n          Free sample packs are currently available within the 50 U.S. states and Washington, D.C.\n        </div>\n\n        <div class=\"kc-field\">\n          <label for=\"kc-address\">\n            Shipping Address <span class=\"kc-required\">*</span>\n          </label>\n\n          <input\n            id=\"kc-address\"\n            type=\"text\"\n            name=\"contact[Shipping Address]\"\n            autocomplete=\"address-line1\"\n            required\n          >\n        </div>\n\n        <div class=\"kc-field\">\n          <label for=\"kc-address-2\">\n            Suite / Unit / Building\n          </label>\n\n          <input\n            id=\"kc-address-2\"\n            type=\"text\"\n            name=\"contact[Suite / Unit / Building]\"\n            autocomplete=\"address-line2\"\n            placeholder=\"Optional\"\n          >\n        </div>\n\n        <div class=\"kc-address-grid\">\n\n          <div class=\"kc-field\">\n            <label for=\"kc-city\">\n              City <span class=\"kc-required\">*</span>\n            </label>\n\n            <input\n              id=\"kc-city\"\n              type=\"text\"\n              name=\"contact[City]\"\n              autocomplete=\"address-level2\"\n              required\n            >\n          </div>\n\n          <div class=\"kc-field\">\n            <label for=\"kc-state\">\n              State <span class=\"kc-required\">*</span>\n            </label>\n\n            <select\n              id=\"kc-state\"\n              name=\"contact[State]\"\n              autocomplete=\"address-level1\"\n              required\n            >\n              <option value=\"\">Select state</option>\n              <option value=\"AL\">Alabama</option>\n              <option value=\"AK\">Alaska</option>\n              <option value=\"AZ\">Arizona</option>\n              <option value=\"AR\">Arkansas</option>\n              <option value=\"CA\">California</option>\n              <option value=\"CO\">Colorado</option>\n              <option value=\"CT\">Connecticut</option>\n              <option value=\"DE\">Delaware</option>\n              <option value=\"DC\">District of Columbia</option>\n              <option value=\"FL\">Florida</option>\n              <option value=\"GA\">Georgia</option>\n              <option value=\"HI\">Hawaii</option>\n              <option value=\"ID\">Idaho</option>\n              <option value=\"IL\">Illinois</option>\n              <option value=\"IN\">Indiana</option>\n              <option value=\"IA\">Iowa</option>\n              <option value=\"KS\">Kansas</option>\n              <option value=\"KY\">Kentucky</option>\n              <option value=\"LA\">Louisiana</option>\n              <option value=\"ME\">Maine</option>\n              <option value=\"MD\">Maryland</option>\n              <option value=\"MA\">Massachusetts</option>\n              <option value=\"MI\">Michigan</option>\n              <option value=\"MN\">Minnesota</option>\n              <option value=\"MS\">Mississippi</option>\n              <option value=\"MO\">Missouri</option>\n              <option value=\"MT\">Montana</option>\n              <option value=\"NE\">Nebraska</option>\n              <option value=\"NV\">Nevada</option>\n              <option value=\"NH\">New Hampshire</option>\n              <option value=\"NJ\">New Jersey</option>\n              <option value=\"NM\">New Mexico</option>\n              <option value=\"NY\">New York</option>\n              <option value=\"NC\">North Carolina</option>\n              <option value=\"ND\">North Dakota</option>\n              <option value=\"OH\">Ohio</option>\n              <option value=\"OK\">Oklahoma</option>\n              <option value=\"OR\">Oregon</option>\n              <option value=\"PA\">Pennsylvania</option>\n              <option value=\"RI\">Rhode Island</option>\n              <option value=\"SC\">South Carolina</option>\n              <option value=\"SD\">South Dakota</option>\n              <option value=\"TN\">Tennessee</option>\n              <option value=\"TX\">Texas</option>\n              <option value=\"UT\">Utah</option>\n              <option value=\"VT\">Vermont</option>\n              <option value=\"VA\">Virginia</option>\n              <option value=\"WA\">Washington</option>\n              <option value=\"WV\">West Virginia</option>\n              <option value=\"WI\">Wisconsin</option>\n              <option value=\"WY\">Wyoming</option>\n            </select>\n          </div>\n\n          <div class=\"kc-field\">\n            <label for=\"kc-zip\">\n              ZIP Code <span class=\"kc-required\">*</span>\n            </label>\n\n            <input\n              id=\"kc-zip\"\n              type=\"text\"\n              name=\"contact[ZIP Code]\"\n              autocomplete=\"postal-code\"\n              inputmode=\"numeric\"\n              pattern=\"[0-9]{5}(-[0-9]{4})?\"\n              placeholder=\"12345\"\n              required\n            >\n          </div>\n\n        </div>\n\n      </div>\n\n      <!-- 04 SPECIFIC PRODUCTS -->\n\n      <div class=\"kc-form-section\">\n\n        <div class=\"kc-section-heading\">\n          <span class=\"kc-section-number\">04</span>\n          <h3>Looking for Something Specific?</h3>\n        </div>\n\n        <div class=\"kc-field\">\n\n          <label for=\"kc-sample-notes\">\n            Products or Questions\n          </label>\n\n          <textarea\n            id=\"kc-sample-notes\"\n            name=\"contact[Products or Questions]\"\n            placeholder=\"Example: We're considering 6.5-inch keg collars, paper coasters and menus. I'd especially like to see examples of those.\"\n          ></textarea>\n\n          <p class=\"kc-help\">\n            Optional — tell us about products you're considering or anything you'd especially like included.\n          </p>\n\n        </div>\n\n      </div>\n\n      <div